extends layout

block styles
  link(rel="stylesheet", href="/css/room.css")

block content
  main(data-lk-theme="default", style="height: 100%;")
    #pre-join-container(style="display: grid; place-items: center; height: 100%;")
      .pre-join-box
        h2 Join Meeting
        .video-preview-container
          #video-preview
            video#preview-video(autoplay, muted, playsinline)
            .camera-off-placeholder(style="display: none;")
              svg(width="48", height="48", viewBox="0 0 24 24")
                path(fill="currentColor", d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z")
        
        form#pre-join-form
          .form-group
            label(for="username") Your Name
            input#username(type="text", required)
          
          .device-controls
            .device-control-group
              button#toggle-video-preview.device-control-button(type="button")
                span.icon
                  svg(width="20", height="20", viewBox="0 0 24 24")
                    path(fill="currentColor", d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z")
                span.label Camera
              select#video-device-select.device-select
                option(value="") Loading cameras...
            
            .device-control-group
              button#toggle-audio-preview.device-control-button(type="button")
                span.icon
                  svg(width="20", height="20", viewBox="0 0 24 24")
                    path(fill="currentColor", d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm5.91-3c-.49 0-.9.36-.98.85C16.52 14.2 14.47 16 12 16s-4.52-1.8-4.93-4.15c-.08-.49-.49-.85-.98-.85-.61 0-1.09.54-1 1.14.49 3 2.89 5.35 5.91 5.78V20c0 .55.45 1 1 1s1-.45 1-1v-2.08c3.02-.43 5.42-2.78 5.91-5.78.1-.6-.39-1.14-1-1.14z")
                span.label Microphone
              select#audio-device-select.device-select
                option(value="") Loading microphones...
          
          .form-group
            button.lk-button.join-button(type="submit") Join Meeting

    #conference-container(style="display: none; height: 100%;")
      .video-conference
        .participants-area
          #remote-participants.remote-participants
            #local-participant.participant-tile
              .video-container
                video#local-video(autoplay, muted, playsinline)
              .participant-info
                .participant-name Local (You)
          
          #pagination-controls.pagination-controls(style="display: none;")
            button#prev-page.pagination-button
              svg(width="24", height="24", viewBox="0 0 24 24")
                path(fill="currentColor", d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z")
            span#page-indicator 1 / 1
            button#next-page.pagination-button
              svg(width="24", height="24", viewBox="0 0 24 24")
                path(fill="currentColor", d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z")
        
        .controls-area
          button#toggle-video.control-button
            span.icon
              svg(width="24", height="24", viewBox="0 0 24 24")
                path(fill="currentColor", d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z")
            span.label Toggle Video
          
          button#toggle-audio.control-button
            span.icon
              svg(width="24", height="24", viewBox="0 0 24 24")
                path(fill="currentColor", d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm5.91-3c-.49 0-.9.36-.98.85C16.52 14.2 14.47 16 12 16s-4.52-1.8-4.93-4.15c-.08-.49-.49-.85-.98-.85-.61 0-1.09.54-1 1.14.49 3 2.89 5.35 5.91 5.78V20c0 .55.45 1 1 1s1-.45 1-1v-2.08c3.02-.43 5.42-2.78 5.91-5.78.1-.6-.39-1.14-1-1.14z")
            span.label Toggle Audio
          
          button#share-screen.control-button
            span.icon
              svg(width="24", height="24", viewBox="0 0 24 24")
                path(fill="currentColor", d="M20 18c1.1 0 1.99-.9 1.99-2L22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2H0v2h24v-2h-4zM4 6h16v10H4V6z")
            span.label Share Screen
          
          button#toggle-chat.control-button
            span.icon
              svg(width="24", height="24", viewBox="0 0 24 24")
                path(fill="currentColor", d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z")
            span.label Chat
          
          button#record-meeting.control-button
            span.icon
              svg(width="24", height="24", viewBox="0 0 24 24")
                path(fill="currentColor", d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z")
            span.label Record
            
          button#leave-room.control-button.danger
            span.icon
              svg(width="24", height="24", viewBox="0 0 24 24")
                path(fill="currentColor", d="M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z")
            span.label Leave
        
        #chat-panel.chat-panel(style="display: none;")
          .chat-header
            h3 Chat
            button#close-chat ✕
          .chat-messages#chat-messages
          .chat-input
            form#chat-form
              input#chat-message(type="text", placeholder="Type a message...")
              button(type="submit") Send

block scripts
  script.
    // Pass server-side variables to client-side JavaScript
    window.ROOM_NAME = "#{.roomName}";
    window.REGION = "";
    window.HQ = false;
    window.CODEC = "";
  script(src="https://cdn.jsdelivr.net/npm/livekit-client/dist/livekit-client.umd.js")
  script(src="/js/utils.js")
  script(src="/js/room.js")
