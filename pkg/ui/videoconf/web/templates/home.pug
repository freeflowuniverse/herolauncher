doctype html
html
  head
    title OurWorld Meet
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css")
    link(rel="stylesheet" href="/css/style.css")
  body
    main.container
      // Rooms section
      section.rooms-section
        h2 Meeting Rooms
        div
          div(style="display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem;")
            // Create Room Card (First Card)
            div
              article(style="border: 2px dashed var(--primary);")
                header
                  h3 Create a Room
                form(action="/api/room" method="post")
                  div
                    label(for="name") Room Name
                    input(type="text" id="name" name="name" placeholder="Enter room name")
                  div
                    label(for="metadata") Metadata (optional)
                    input(type="text" id="metadata" name="metadata" placeholder="Add metadata as JSON")
                  button(type="submit") Create Room
            
            // Existing Room Cards
            | {{if .rooms}}
            | {{range .rooms}}
            div
              article
                header
                  h3 {{.Name}}
                  | {{if .Metadata}}
                  small Metadata: {{.Metadata}}
                  | {{end}}
                div
                  p
                    strong Participants: 
                    span {{.NumParticipants}}/{{.MaxParticipants}}
                  p
                    strong Created: 
                    span {{formatTime .CreationTime}}
                  | {{if .ActiveRecording}}
                  p(style="background-color: rgba(255, 59, 48, 0.1); padding: 0.3rem 0.5rem; border-radius: 4px;")
                    strong Recording Active
                  | {{end}}
                footer
                  a(href="/room/{{.Name}}" role="button") Join Room
            | {{end}}
            | {{else}}
            div(style="grid-column: 2 / span 3;")
              article(style="border: 1px dashed gray;")
                div
                  h3 No Rooms Available
                  p No meeting rooms have been created yet. Create your first room using the form.
            | {{end}}
      
      // Meetings Table
      section(style="margin-top: 2rem;")
        h2 Recent Meetings
        figure
          table
            thead
              tr
                th Room Name
                th Description
                th Participants
                th Duration
                th Created
                th Status
                th Actions
            tbody
              | {{if .rooms}}
              | {{range .rooms}}
              tr
                td {{.Name}}
                td {{if .Metadata}}{{.Metadata}}{{else}}No description{{end}}
                td {{.NumParticipants}}/{{.MaxParticipants}}
                td {{if .ActiveRecording}}Active{{else}}{{if gt .NumParticipants 0}}In progress{{else}}Ended{{end}}{{end}}
                td {{formatTime .CreationTime}}
                td
                  | {{if gt .NumParticipants 0}}
                  span(style="display: inline-block; padding: 0.25rem 0.5rem; border-radius: 1rem; font-size: 0.75rem; font-weight: 500; background-color: var(--form-element-valid-focus-border-color); color: white;") Active
                  | {{else}}
                  span(style="display: inline-block; padding: 0.25rem 0.5rem; border-radius: 1rem; font-size: 0.75rem; font-weight: 500; background-color: var(--secondary); color: white;") Inactive
                  | {{end}}
                td
                  div(style="display: flex; gap: 0.5rem;")
                    a(href="/room/{{.Name}}" role="button" class="outline" style="margin: 0; padding: 0.25rem 0.5rem; font-size: 0.8rem;") Join
                    button.outline.secondary(data-room="{{.Name}}" style="margin: 0; padding: 0.25rem 0.5rem; font-size: 0.8rem;") Delete
              | {{end}}
              | {{else}}
              tr
                td(colspan="7" style="text-align: center;") No meeting rooms available. Create your first room above.
              | {{end}}
      
      | {{if .connectionError}}
      // Connection Error Alert
      div(style="position: fixed; bottom: 20px; right: 20px; max-width: 400px; z-index: 1000;")
        article(role="alert" style="margin: 0; background-color: var(--card-background-color); border-left: 5px solid var(--del-color);")
          div(style="padding: 1rem;")
            h4(style="margin: 0 0 0.5rem 0;") Connection Error
            p(style="margin: 0;") Unable to connect to the video conferencing service. Please check your internet connection and try again later.
      | {{end}}
