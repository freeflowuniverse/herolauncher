{{ extends "./layout" }}

{{ block documentBody() }}
<article>
    <header>
        <h2>Package Manager</h2>
        <p>Install and manage packages</p>
    </header>
    
    <div class="grid">
        <div>
            <article>
                <header>
                    <h3>Installed Packages</h3>
                </header>
                
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Version</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>web-ui</td>
                            <td>1.2.0</td>
                            <td>
                                <span class="badge success">Installed</span>
                            </td>
                            <td>
                                <div role="group">
                                    <button class="outline">Update</button>
                                    <button class="outline secondary">Remove</button>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td>redis-client</td>
                            <td>2.0.1</td>
                            <td>
                                <span class="badge success">Installed</span>
                            </td>
                            <td>
                                <div role="group">
                                    <button class="outline">Update</button>
                                    <button class="outline secondary">Remove</button>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td>executor-service</td>
                            <td>0.9.5</td>
                            <td>
                                <span class="badge warning">Update Available</span>
                            </td>
                            <td>
                                <div role="group">
                                    <button class="outline">Update</button>
                                    <button class="outline secondary">Remove</button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </article>
        </div>
        
        <div>
            <article>
                <header>
                    <h3>Install New Package</h3>
                </header>
                
                <form>
                    <label for="package-name">Package Name</label>
                    <input id="package-name" type="text" placeholder="Enter package name">
                    
                    <label for="package-version">Version (optional)</label>
                    <input id="package-version" type="text" placeholder="Latest">
                    
                    <button type="submit">Install Package</button>
                </form>
            </article>
        </div>
    </div>
</article>
{{ end }}