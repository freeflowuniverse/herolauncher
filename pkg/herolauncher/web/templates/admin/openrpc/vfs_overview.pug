div.row.mb-4
  div.col
    div.card
      div.card-header
        h5.mb-0 OpenRPC Schema
      div.card-body
        p The OpenRPC schema describes all available methods for interacting with the Virtual File System.
        a.btn.btn-primary(href="/api/vfs/openrpc" target="_blank") View Schema

div.row
  div.col
    div.card
      div.card-header
        h5.mb-0 Available Methods
      div.card-body
        table.table.table-striped
          thead
            tr
              th Method
              th Description
          tbody
            tr
              td UploadFile
              td Uploads a file to the virtual file system
            tr
              td UploadDir
              td Uploads a directory to the virtual file system
            tr
              td DownloadFile
              td Downloads a file from the virtual file system
            tr
              td ExportMeta
              td Exports metadata from the virtual file system
            tr
              td ImportMeta
              td Imports metadata to the virtual file system
            tr
              td ExportDedupe
              td Exports dedupe information from the virtual file system
            tr
              td ImportDedupe
              td Imports dedupe information to the virtual file system
            tr
              td Send
              td Sends files based on dedupe hashes to a destination
            tr
              td SendExist
              td Checks which dedupe hashes exist and returns a list
            tr
              td ExposeWebDAV
              td Exposes the virtual file system via WebDAV
            tr
              td Expose9P
              td Exposes the virtual file system via 9P protocol

div.row.mt-4
  div.col
    div.card
      div.card-header
        h5.mb-0 API Testing
      div.card-body
        p.mb-3 You can test the VFS API methods directly from this interface.
        div.form-group.mb-3
          label(for="method-select") Select Method:
          select#method-select.form-control
            option(value="") -- Select a method --
            option(value="UploadFile") UploadFile
            option(value="UploadDir") UploadDir
            option(value="DownloadFile") DownloadFile
            option(value="ExportMeta") ExportMeta
            option(value="ImportMeta") ImportMeta
            option(value="ExportDedupe") ExportDedupe
            option(value="ImportDedupe") ImportDedupe
            option(value="Send") Send
            option(value="SendExist") SendExist
            option(value="ExposeWebDAV") ExposeWebDAV
            option(value="Expose9P") Expose9P
        
        div#method-params.d-none
          h6.mb-3 Parameters:
          div#param-fields
          
          button#execute-btn.btn.btn-primary.mt-3 Execute Method
        
        div#result-container.mt-4.d-none
          h6 Result:
          pre#result-output.bg-light.p-3.border.rounded
