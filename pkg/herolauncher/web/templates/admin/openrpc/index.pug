extends ../layout

block content
  div.container-fluid.p-4
    div.row.mb-4
      div.col
        h1.mb-3 OpenRPC Manager
        p.lead This page provides access to all available OpenRPC servers and their APIs.
    
    div.row.mb-4
      div.col
        div.card
          div.card-header
            h5.mb-0 Available OpenRPC Servers
          div.card-body
            table.table.table-striped
              thead
                tr
                  th Server Name
                  th Description
                  th Status
                  th Actions
              tbody
                tr
                  td Virtual File System (VFS)
                  td Provides file system operations including upload, download, and metadata management
                  td 
                    span.badge.bg-success Running
                  td
                    a.btn.btn-sm.btn-primary(href="/admin/openrpc/vfs") View API
                    a.btn.btn-sm.btn-secondary.ms-2(href="/api/vfs/openrpc" target="_blank") Schema
    
    div.row
      div.col
        div.card
          div.card-header
            h5.mb-0 OpenRPC Information
          div.card-body
            p 
              strong What is OpenRPC?
              |  OpenRPC is a standard for describing JSON-RPC 2.0 APIs, similar to how OpenAPI (Swagger) describes REST APIs.
            
            p 
              strong Benefits:
            ul
              li Standardized API documentation
              li Automatic client and server code generation
              li Consistent interface across different programming languages
              li Self-documenting APIs with built-in schema validation
            
            p 
              strong Learn more:
              |  
              a(href="https://open-rpc.org/" target="_blank") open-rpc.org

block scripts
  script.
    document.addEventListener('DOMContentLoaded', function() {
      // Add any JavaScript functionality here
      console.log('OpenRPC Manager page loaded');
    });
