extends ../layout

block content
  article.processes-info
    header
      h2.title System Processes
      p(class='description text-muted') Overview of running processes with CPU and memory usage
    
    .grid(style="display: grid; grid-template-columns: 1fr; gap: 1rem;")
      div
        article.processes-table
          header
            h3#processes-title Running Processes
            p.refresh-status
              // Refresh button with loading indicator - only shows loading state during refresh
              button.btn.btn-sm(onclick="refreshProcesses()")
                | Refresh
                span.loading-indicator#refresh-loading(style="display: none;") &nbsp;Loading...
          
          // Table with process information that updates periodically
          .processes-table-content(up-poll="/admin/system/processes-data" up-interval="10000" style="display: block; width: 100%;" id="processes-content")
            | {{if .error}}
            .alert.alert-danger {{.error}}
            | {{end}}
            
            // Display the processes table directly here rather than using a separate template
            table.processes-stats(class="table table-striped")
              thead
                tr
                  th(scope='col') PID
                  th(scope='col') Name
                  th(scope='col') Status
                  th(scope='col') CPU (%)
                  th(scope='col') Memory (MB)
                  th(scope='col') Created
              tbody
                | {{if .processes}}
                | {{range .processes}}
                tr(class="{{if .is_current}}table-primary{{end}}")
                  td {{.pid}}
                  td {{.name}}
                  td {{.status}}
                  td {{printf "%.1f%%" .cpu_percent}}
                  td {{printf "%.1f MB" .memory_mb}}
                  td {{.create_time_str}}
                | {{end}}
                | {{else}}
                tr
                  td(colspan="6") No process data available.
                | {{end}}
