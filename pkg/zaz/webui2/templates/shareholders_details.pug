extends layout

block content
  article.compact
    header.slim-header
      h2 Shareholder Details
      .header-actions.button-group
        a(href="/shareholders" role="button" class="outline small") Back to List
        a(href="/companies/
          {{.company.ID}}
          " role="button" class="outline small") View Company
        
    .shareholder-info.grid
      .shareholder-profile
        h3
          {{.shareholder.Name}}
        
        p.type
          strong Type: 
          span
            {{.shareholder.Type}}
        
        p.since
          strong Shareholder Since: 
          span
            {{.shareholder.Since.Format "2006-01-02"}}
          
        p.company
          strong Company: 
          a(href="/companies/
            {{.company.ID}}
            ")
            {{.company.Name}}
          
      .shareholder-holdings
        h3 Holdings Information
        
        .holdings-stats
          .stat-item
            h4 Shares
            p.shares-count
              {{.shareholder.Shares}}
            
          .stat-item
            h4 Percentage
            p.percentage
              {{.shareholder.Percentage}}%
            
        | {{if gt .shareholder.Shares 0}}
        .holdings-chart
          .chart-bar
            .bar-fill(style="width: 
              {{.shareholder.Percentage}}
              %")
          .chart-label
            {{.shareholder.Percentage}}% ownership
        | {{end}}
        
    .shareholder-activity
      h3 Activity History
      
      | {{if .activities}}
      table
        thead
          tr
            th Date
            th Action
            th Details
        tbody
          | {{range .activities}}
          tr
            td {{.Date.Format "2006-01-02"}}
            td {{.Action}}
            td {{.Details}}
          | {{end}}
      | {{else}}
      p.no-data No activity history available for this shareholder.
      | {{end}}
      
    .shareholder-documents
      h3 Documents
      
      | {{if .documents}}
      ul.document-list
        | {{range .documents}}
        li
          a(href="{{.URL}}" target="_blank") {{.Name}}
          span.document-date {{.Date.Format "2006-01-02"}}
        | {{end}}
      | {{else}}
      p.no-data No documents available for this shareholder.
      | {{end}}
      
    .action-buttons
      a(href="/shareholders/{{.shareholder.ID}}/edit" role="button" class="primary") Edit Shareholder
      | {{if eq .shareholder.Type "Individual"}}
      a(href="/shareholders/{{.shareholder.ID}}/contact" role="button" class="secondary") Contact Shareholder
      | {{end}}
