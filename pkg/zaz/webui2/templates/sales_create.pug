extends layout

block content
  article
    header
      h2 Create New Sale
      p Record a new sale transaction in the Freezone
    
    | {{if .formErrors}}
    .form-errors
      h4 Please correct the following errors:
      ul
        | {{range .formErrors}}
        li {{.}}
        | {{end}}
    | {{end}}
    
    form(action="/sales/create" method="post")
      | {{if .csrfToken}}
      input(type="hidden" name="csrf_token" value="{{.csrfToken}}")
      | {{end}}
      
      .grid
        div
          label(for="company_id") Company
          select(id="company_id" name="company_id")
            option(value="") Select company
            | {{range .companies}}
            option(value="{{.ID}}") {{.Name}}
            | {{end}}
        
        div
          label(for="sale_type") Sale Type
          select(id="sale_type" name="sale_type")
            option(value="") Select type
            option(value="product") Product
            option(value="service") Service
            option(value="subscription") Subscription
            option(value="other") Other
      
      .product-section(style="display: none;")
        fieldset
          legend Product Details
          
          .grid
            div
              label(for="product_id") Select Product
              select(id="product_id" name="product_id")
                option(value="") Select a product
                | {{range .products}}
                option(value="{{.ID}}") {{.Name}} - ${{.Price}}
                | {{end}}
            
            div
              label(for="quantity") Quantity
              input(type="number" id="quantity" name="quantity" min="1" value="1")
      
      .service-section(style="display: none;")
        fieldset
          legend Service Details
          
          .grid
            div
              label(for="service_id") Select Service
              select(id="service_id" name="service_id")
                option(value="") Select a service
                | {{range .services}}
                option(value="{{.ID}}") {{.Name}} - ${{.Rate}}
                | {{end}}
            
            div
              label(for="hours") Hours
              input(type="number" id="hours" name="hours" min="0.5" step="0.5" value="1")
      
      .subscription-section(style="display: none;")
        fieldset
          legend Subscription Details
          
          .grid
            div
              label(for="subscription_plan") Subscription Plan
              select(id="subscription_plan" name="subscription_plan")
                option(value="") Select a plan
                option(value="monthly") Monthly
                option(value="quarterly") Quarterly
                option(value="annual") Annual
            
            div
              label(for="duration") Duration (Months)
              input(type="number" id="duration" name="duration" min="1" value="1")
      
      .grid
        div
          label(for="customer_name") Customer Name
          input(type="text" id="customer_name" name="customer_name" placeholder="Enter customer name" value="{{.form.CustomerName}}")
        
        div
          label(for="customer_email") Customer Email
          input(type="email" id="customer_email" name="customer_email" placeholder="customer@example.com" value="{{.form.CustomerEmail}}")
      
      .grid
        div
          label(for="amount") Amount ($)
          input(type="number" id="amount" name="amount" min="0.01" step="0.01" placeholder="Sale amount" value="{{.form.Amount}}")
        
        div
          label(for="sale_date") Sale Date
          input(type="date" id="sale_date" name="sale_date" value="{{.form.SaleDate}}")
      
      .grid
        div
          label(for="payment_method") Payment Method
          select(id="payment_method" name="payment_method")
            option(value="") Select payment method
            option(value="credit_card") Credit Card
            option(value="bank_transfer") Bank Transfer
            option(value="cash") Cash
            option(value="crypto") Cryptocurrency
            option(value="other") Other
        
        div
          label(for="status") Status
          select(id="status" name="status")
            option(value="") Select status
            option(value="pending") Pending
            option(value="paid") Paid
            option(value="shipped") Shipped
            option(value="completed") Completed
            option(value="cancelled") Cancelled
      
      div
        label(for="notes") Notes
        textarea(id="notes" name="notes" placeholder="Additional notes about this sale" rows="3") {{.form.Notes}}
      
      .form-actions
        button(type="submit" role="button") Create Sale
        a(href="/sales" role="button" class="secondary") Cancel

block scripts
  script.
    // Toggle between product, service, and subscription sections
    document.getElementById('sale_type').addEventListener('change', function() {
      const productSection = document.querySelector('.product-section');
      const serviceSection = document.querySelector('.service-section');
      const subscriptionSection = document.querySelector('.subscription-section');
      
      // Hide all sections first
      productSection.style.display = 'none';
      serviceSection.style.display = 'none';
      subscriptionSection.style.display = 'none';
      
      // Show the appropriate section based on selection
      if (this.value === 'product') {
        productSection.style.display = 'block';
      } else if (this.value === 'service') {
        serviceSection.style.display = 'block';
      } else if (this.value === 'subscription') {
        subscriptionSection.style.display = 'block';
      }
    });
    
    // Auto-calculate amount based on product selection
    document.getElementById('product_id').addEventListener('change', function() {
      if (this.value) {
        const selectedOption = this.options[this.selectedIndex];
        const priceText = selectedOption.text.split(' - $')[1];
        const price = parseFloat(priceText);
        const quantity = parseInt(document.getElementById('quantity').value);
        
        if (!isNaN(price) && !isNaN(quantity)) {
          document.getElementById('amount').value = (price * quantity).toFixed(2);
        }
      }
    });
    
    document.getElementById('quantity').addEventListener('change', function() {
      const productSelect = document.getElementById('product_id');
      if (productSelect.value) {
        const selectedOption = productSelect.options[productSelect.selectedIndex];
        const priceText = selectedOption.text.split(' - $')[1];
        const price = parseFloat(priceText);
        const quantity = parseInt(this.value);
        
        if (!isNaN(price) && !isNaN(quantity)) {
          document.getElementById('amount').value = (price * quantity).toFixed(2);
        }
      }
    });
    
    // Auto-calculate amount based on service selection
    document.getElementById('service_id').addEventListener('change', function() {
      if (this.value) {
        const selectedOption = this.options[this.selectedIndex];
        const rateText = selectedOption.text.split(' - $')[1];
        const rate = parseFloat(rateText);
        const hours = parseFloat(document.getElementById('hours').value);
        
        if (!isNaN(rate) && !isNaN(hours)) {
          document.getElementById('amount').value = (rate * hours).toFixed(2);
        }
      }
    });
    
    document.getElementById('hours').addEventListener('change', function() {
      const serviceSelect = document.getElementById('service_id');
      if (serviceSelect.value) {
        const selectedOption = serviceSelect.options[serviceSelect.selectedIndex];
        const rateText = selectedOption.text.split(' - $')[1];
        const rate = parseFloat(rateText);
        const hours = parseFloat(this.value);
        
        if (!isNaN(rate) && !isNaN(hours)) {
          document.getElementById('amount').value = (rate * hours).toFixed(2);
        }
      }
    });
