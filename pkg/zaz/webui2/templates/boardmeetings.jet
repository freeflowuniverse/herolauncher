{{ extends "layout.jet" }}

{{ block content() }}
<article>
    <header class="action-header">
        <hgroup>
            <h2>Board Meetings</h2>
            <p>Manage all board meetings in the Freezone</p>
        </hgroup>
        <a href="/boardmeetings/create" role="button">Schedule Meeting</a>
    </header>

    <div class="action-bar">
        <form class="search-form" role="search" action="/boardmeetings" method="get">
            <input type="search" name="search" placeholder="Search meetings..." value="{{ search | default('') }}">
            <button type="submit">Search</button>
        </form>
        {{/* Add filters here if needed, e.g., by company, status */}}
    </div>

    {{ if boardMeetings }}
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Company</th>
                <th>Title</th>
                <th>Date</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {{ range boardMeetings }}
            <tr>
                <td>{{ .ID }}</td>
                <td><a href="/companies/{{ .CompanyID }}">{{ .CompanyName }}</a></td> {{/* Link to company */}}
                <td>{{ .Title }}</td>
                <td>{{ .Date | date("2006-01-02") }}</td>
                <td><span class="status {{ .Status }}">{{ .Status }}</span></td> {{/* Add class for styling */}}
                <td class="actions">
                    <a href="/boardmeetings/{{ .ID }}" title="View Details">Details</a>
                    {{ if .Status == "Completed" || .Status == "In Progress" }} {{/* Allow viewing minutes if completed or in progress */}}
                    <a href="/boardmeetings/{{ .ID }}/minutes" title="View Minutes">Minutes</a>
                    {{ end }}
                    {{/* Add other actions like edit/delete if needed */}}
                </td>
            </tr>
            {{ end }}
        </tbody>
    </table>
    {{ else }}
    <div class="empty-state">
        <p>No board meetings found</p>
        {{ if search }}
        <p>No results for "{{ search }}"</p>
        <a href="/boardmeetings" role="button" class="secondary">Clear search</a>
        {{ else }}
        <a href="/boardmeetings/create" role="button">Schedule your first meeting</a>
        {{ end }}
    </div>
    {{ end }}

    {{/* Add pagination if needed */}}
</article>
{{ end }}
