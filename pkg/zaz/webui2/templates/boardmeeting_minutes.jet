{{ extends "layout.jet" }}

{{ block content() }}
<article class="compact">
    <header class="slim-header">
        <h2>Meeting Minutes</h2>
        <div class="header-actions button-group">
            {{/* Assuming a dynamic link back to the specific meeting */}}
            <a href="/boardmeetings/{{ meeting.ID }}" role="button" class="outline small">Back to Meeting</a>
        </div>
    </header>

    <div class="meeting-header">
        <h3>Board Meeting Minutes</h3>
        <div class="meeting-meta">
            <p><strong>Company: </strong><a href="/companies/{{ meeting.CompanyID }}">{{ meeting.CompanyName }}</a></p>
            <p><strong>Date: </strong><span>{{ meeting.Date | date("2006-01-02") }}</span></p>
            <p><strong>Location: </strong><span>{{ meeting.Location }}</span></p>
            <p><strong>Status: </strong><span class="status {{ meeting.Status }}">{{ meeting.Status }}</span></p>
        </div>
    </div>

    {{ if meeting.Status == "In Progress" || meeting.Status == "Scheduled" }} {{/* Show form if meeting is not completed */}}
    <form action="/boardmeetings/{{ meeting.ID }}/minutes" method="post">
        {{ if csrfToken }}
        <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
        {{ end }}
        <section class="minutes-form">
            <fieldset>
                <legend>Meeting Information</legend>
                <div class="grid">
                    <div>
                        <label for="start_time">Start Time</label>
                        <input type="time" id="start_time" name="start_time" value="{{ minutes.StartTime }}">
                    </div>
                    <div>
                        <label for="end_time">End Time</label>
                        <input type="time" id="end_time" name="end_time" value="{{ minutes.EndTime }}">
                    </div>
                </div>
            </fieldset>

            <fieldset>
                <legend>Attendees</legend>
                <div class="attendees-section">
                    {{ range meeting.Attendees }}
                    <div class="checkbox-item">
                        <input type="checkbox" id="attendee_{{ .ID }}" name="attendees[]" value="{{ .ID }}" {{ if minutes.IsAttendeePresent(.ID) }}checked{{ end }}>
                        <label for="attendee_{{ .ID }}">{{ .Name }} ({{ .Role }})</label>
                    </div>
                    {{ end }}
                    <div>
                        <label for="additional_attendees">Additional Attendees</label>
                        <input type="text" id="additional_attendees" name="additional_attendees" placeholder="Other attendees not listed above" value="{{ minutes.AdditionalAttendees }}">
                    </div>
                </div>
            </fieldset>

            <fieldset>
                <legend>Agenda and Discussion</legend>
                {{ range $index, $item := meeting.AgendaItems }}
                <div class="agenda-item">
                    <h4>{{ $index + 1 }}. {{ $item.Title }}</h4>
                    <div>
                        <label for="discussion_{{ $index }}">Discussion</label>
                        <textarea id="discussion_{{ $index }}" name="discussions[{{ $item.ID }}]" rows="4" placeholder="Record discussion for this agenda item">{{ minutes.GetDiscussion($item.ID) }}</textarea>
                    </div>
                    <div>
                        <label for="decision_{{ $index }}">Decision/Action Item</label>
                        <textarea id="decision_{{ $index }}" name="decisions[{{ $item.ID }}]" rows="2" placeholder="Record any decisions or action items">{{ minutes.GetDecision($item.ID) }}</textarea>
                    </div>
                </div>
                {{ else }}
                <p>No agenda items defined for this meeting.</p>
                {{ end }}
            </fieldset>

            <fieldset>
                <legend>Resolutions</legend>
                <div class="resolutions-section">
                    <div class="resolution-items" id="resolution-items-container">
                        {{ range $index, $res := minutes.Resolutions }}
                        <div class="resolution-item">
                             <input type="hidden" name="resolution_ids[]" value="{{ $res.ID }}">
                             <div>
                                 <label for="resolution_title_{{ $index }}">Resolution Title</label>
                                 <input type="text" id="resolution_title_{{ $index }}" name="resolution_titles[]" placeholder="Resolution title" value="{{ $res.Title }}">
                             </div>
                             <div>
                                 <label for="resolution_text_{{ $index }}">Resolution Text</label>
                                 <textarea id="resolution_text_{{ $index }}" name="resolution_texts[]" rows="3" placeholder="Full text of the resolution">{{ $res.Text }}</textarea>
                             </div>
                             <div class="grid">
                                 <div>
                                     <label for="resolution_votes_for_{{ $index }}">Votes For</label>
                                     <input type="number" id="resolution_votes_for_{{ $index }}" name="resolution_votes_for[]" min="0" value="{{ $res.VotesFor }}">
                                 </div>
                                 <div>
                                     <label for="resolution_votes_against_{{ $index }}">Votes Against</label>
                                     <input type="number" id="resolution_votes_against_{{ $index }}" name="resolution_votes_against[]" min="0" value="{{ $res.VotesAgainst }}">
                                 </div>
                                 <div>
                                     <label for="resolution_votes_abstained_{{ $index }}">Abstained</label>
                                     <input type="number" id="resolution_votes_abstained_{{ $index }}" name="resolution_votes_abstained[]" min="0" value="{{ $res.VotesAbstained }}">
                                 </div>
                             </div>
                             <div>
                                 <label for="resolution_result_{{ $index }}">Result</label>
                                 <select id="resolution_result_{{ $index }}" name="resolution_results[]">
                                     <option value="" {{ if $res.Result == "" }}selected{{ end }}>Select result</option>
                                     <option value="Approved" {{ if $res.Result == "Approved" }}selected{{ end }}>Approved</option>
                                     <option value="Rejected" {{ if $res.Result == "Rejected" }}selected{{ end }}>Rejected</option>
                                     <option value="Deferred" {{ if $res.Result == "Deferred" }}selected{{ end }}>Deferred</option>
                                     <option value="Withdrawn" {{ if $res.Result == "Withdrawn" }}selected{{ end }}>Withdrawn</option>
                                 </select>
                             </div>
                             <button class="remove-resolution" type="button">Remove</button>
                         </div>
                        {{ end }}
                        {{/* Template for new resolution items - used by JS */}}
                        <template id="resolution-template">
                            <div class="resolution-item">
                                <input type="hidden" name="resolution_ids[]" value="new">
                                <div>
                                    <label for="resolution_title_new">Resolution Title</label>
                                    <input type="text" id="resolution_title_new" name="resolution_titles[]" placeholder="Resolution title">
                                </div>
                                <div>
                                    <label for="resolution_text_new">Resolution Text</label>
                                    <textarea id="resolution_text_new" name="resolution_texts[]" rows="3" placeholder="Full text of the resolution"></textarea>
                                </div>
                                <div class="grid">
                                    <div>
                                        <label for="resolution_votes_for_new">Votes For</label>
                                        <input type="number" id="resolution_votes_for_new" name="resolution_votes_for[]" min="0" value="0">
                                    </div>
                                    <div>
                                        <label for="resolution_votes_against_new">Votes Against</label>
                                        <input type="number" id="resolution_votes_against_new" name="resolution_votes_against[]" min="0" value="0">
                                    </div>
                                    <div>
                                        <label for="resolution_votes_abstained_new">Abstained</label>
                                        <input type="number" id="resolution_votes_abstained_new" name="resolution_votes_abstained[]" min="0" value="0">
                                    </div>
                                </div>
                                <div>
                                    <label for="resolution_result_new">Result</label>
                                    <select id="resolution_result_new" name="resolution_results[]">
                                        <option value="" selected>Select result</option>
                                        <option value="Approved">Approved</option>
                                        <option value="Rejected">Rejected</option>
                                        <option value="Deferred">Deferred</option>
                                        <option value="Withdrawn">Withdrawn</option>
                                    </select>
                                </div>
                                <button class="remove-resolution" type="button">Remove</button>
                            </div>
                        </template>
                    </div>
                    <button type="button" id="add-resolution-btn">+ Add Resolution</button>
                </div>
            </fieldset>

            <fieldset>
                <legend>Additional Notes</legend>
                <div>
                    <label for="additional_notes">Additional Notes</label>
                    <textarea id="additional_notes" name="additional_notes" rows="5" placeholder="Any additional notes or comments about the meeting">{{ minutes.AdditionalNotes }}</textarea>
                </div>
            </fieldset>

            <div class="form-actions">
                <button type="submit" name="action" value="save" role="button">Save Minutes</button>
                {{ if meeting.Status == "In Progress" }}
                <button type="submit" name="action" value="finalize" role="button" class="secondary">Finalize Minutes</button>
                {{ end }}
            </div>
        </section>
    </form>
    {{ else }} {{/* Show read-only view if meeting is completed */}}
    <section class="minutes-view">
        <div class="minutes-meta">
             <p><strong>Start Time: </strong><span>{{ minutes.StartTime | default("Not recorded") }}</span></p>
             <p><strong>End Time: </strong><span>{{ minutes.EndTime | default("Not recorded") }}</span></p>
             <p><strong>Recorded By: </strong><span>{{ minutes.RecordedBy | default("Unknown") }}</span></p>
        </div>

        <section class="attendees-list">
            <h4>Attendees</h4>
            {{ if minutes.PresentAttendees }}
            <ul>
                {{ range minutes.PresentAttendees }}
                <li>{{ .Name }} ({{ .Role }})</li>
                {{ end }}
            </ul>
             {{ if minutes.AdditionalAttendees }}
             <p><strong>Additional:</strong> {{ minutes.AdditionalAttendees }}</p>
             {{ end }}
            {{ else }}
            <p>No attendees recorded.</p>
            {{ end }}
        </section>

        <section class="agenda-discussions">
            <h4>Agenda and Discussions</h4>
            {{ range $index, $item := meeting.AgendaItems }}
            <div class="agenda-discussion">
                <h5>{{ $index + 1 }}. {{ $item.Title }}</h5>
                <div class="discussion">
                    <h6>Discussion:</h6>
                    <p>{{ minutes.GetDiscussion($item.ID) | default("No discussion recorded.") }}</p>
                </div>
                <div class="decision">
                    <h6>Decision/Action Item:</h6>
                    <p>{{ minutes.GetDecision($item.ID) | default("No decision/action recorded.") }}</p>
                </div>
            </div>
            {{ else }}
            <p>No agenda items discussed or recorded.</p>
            {{ end }}
        </section>

        <section class="resolutions">
            <h4>Resolutions</h4>
            {{ if minutes.Resolutions }}
            {{ range minutes.Resolutions }}
            <div class="resolution">
                <h5>{{ .Title }}</h5>
                <div class="resolution-text">
                    <p>{{ .Text }}</p>
                </div>
                <div class="resolution-result">
                    <p><strong>Result: </strong><span>{{ .Result }} (For: {{ .VotesFor }}, Against: {{ .VotesAgainst }}, Abstained: {{ .VotesAbstained }})</span></p>
                </div>
            </div>
            {{ end }}
            {{ else }}
            <p>No resolutions recorded for this meeting.</p>
            {{ end }}
        </section>

        <section class="additional-notes">
            <h4>Additional Notes</h4>
            <p>{{ minutes.AdditionalNotes | default("No additional notes.") }}</p>
        </section>
    </section>
    {{ end }}

</article>
{{ end }}

{{ block scripts() }}
{{ if meeting.Status == "In Progress" || meeting.Status == "Scheduled" }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const container = document.getElementById('resolution-items-container');
    const addButton = document.getElementById('add-resolution-btn');
    const template = document.getElementById('resolution-template');

    if (!container || !addButton || !template) {
        console.error('Required elements for dynamic resolution form not found.');
        return;
    }

    let resolutionIndex = {{ len(minutes.Resolutions) }}; // Start index based on existing items

    addButton.addEventListener('click', function() {
        const clone = template.content.cloneNode(true);
        const newItem = clone.querySelector('.resolution-item');

        // Update IDs and names to be unique
        newItem.querySelectorAll('[id^="resolution_"]').forEach(el => {
            el.id = el.id.replace('_new', `_${resolutionIndex}`);
            if (el.tagName === 'LABEL') {
                el.htmlFor = el.htmlFor.replace('_new', `_${resolutionIndex}`);
            }
        });
         newItem.querySelectorAll('[name^="resolution_"]').forEach(el => {
            // Name format is like resolution_titles[] - index is implied by order
         });

        container.appendChild(newItem);
        resolutionIndex++;
    });

    container.addEventListener('click', function(event) {
        if (event.target.classList.contains('remove-resolution')) {
            const itemToRemove = event.target.closest('.resolution-item');
            if (itemToRemove) {
                itemToRemove.remove();
                // Note: If you need to handle deleting existing resolutions saved in DB,
                // you might need a hidden field to mark them for deletion on the server.
            }
        }
    });
});
</script>
{{ end }}
{{ end }}
