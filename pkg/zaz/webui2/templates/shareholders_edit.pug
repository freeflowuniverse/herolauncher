extends layout

block content
  article.compact
    header.slim-header
      h2 Edit Shareholder
      .header-actions.button-group
        a(href="/shareholders/
          | {{.shareholder.ID}}
          " role="button" class="outline small") Cancel
        a(href="/shareholders" role="button" class="outline small") Back to List
        
    form(action="/shareholders/
      | {{.shareholder.ID}}
      /edit" method="POST")
      .grid
        .form-group
          label(for="name") Shareholder Name
          input(type="text" id="name" name="name" value="
            | {{.shareholder.Name}}
            ")
          
        .form-group
          label(for="company_id") Company
          select(id="company_id" name="company_id")
            | {{range .companies}}
            option(value="
              | {{.ID}}
              " 
              | {{if eq .ID $.shareholder.CompanyID}}selected{{end}}
              ) 
              | {{.Name}}
            | {{end}}
          
        .form-group
          label(for="shares") Number of Shares
          input(type="number" id="shares" name="shares" value="
            | {{.shareholder.Shares}}
            " min="0")
          
        .form-group
          label(for="percentage") Ownership Percentage
          input(type="number" id="percentage" name="percentage" value="
            | {{.shareholder.Percentage}}
            " min="0" max="100" step="0.01")
          
        .form-group
          label(for="type") Shareholder Type
          select(id="type" name="type")
            option(value="Individual" 
              | {{if eq .shareholder.Type "Individual"}}selected{{end}}
              ) Individual
            option(value="Corporate" 
              | {{if eq .shareholder.Type "Corporate"}}selected{{end}}
              ) Corporate
            
        .form-group
          label(for="since") Shareholder Since
          | {{if not .shareholder.Since.IsZero}}
          input(type="date" id="since" name="since" value="
            | {{.shareholder.Since.Format "2006-01-02"}}
            ")
          | {{else}}
          input(type="date" id="since" name="since")
          | {{end}}
          
      .form-actions
        button(type="submit" class="primary") Save Changes
        a(href="/shareholders/
          | {{.shareholder.ID}}
          " role="button" class="secondary") Cancel
        
      | {{if .error}}
      .error-message
        | {{.error}}
      | {{end}}
