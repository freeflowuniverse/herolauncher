{{ extends "layout.jet" }}

{{ block content() }}
<article>
    <header class="action-header">
        <hgroup>
            <h2>Companies</h2>
            <p>Manage all companies registered in the Freezone</p>
        </hgroup>
        <a href="/companies/create" role="button">Create Company</a>
    </header>

    <div class="action-bar">
        <form class="search-form" role="search" action="/companies" method="get">
            <input type="search" name="search" placeholder="Search companies..." value="{{ search | default('') }}">
            <button type="submit">Search</button>
        </form>
        {{/* Add filters here if needed, e.g., by status, industry */}}
    </div>

    {{/* Debug info - can be removed */}}
    {{/* <p>Found {{ count | default(0) }} companies matching.</p> */}}

    {{ if companies }}
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Status</th>
                <th>Industry</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {{ range companies }}
            <tr>
                <td>{{ .ID }}</td>
                <td>{{ .Name }}</td>
                <td><span class="status {{ .Status }}">{{ .Status }}</span></td> {{/* Add class for styling */}}
                <td>{{ .Industry | default("N/A") }}</td>
                <td class="actions">
                    <a href="/companies/{{ .ID }}" title="View Details">Details</a>
                    <a href="/companies/{{ .ID }}/edit" title="Edit Company">Edit</a>
                    {{/* Add delete action with confirmation if needed */}}
                    {{/* <form action="/companies/{{.ID}}/delete" method="post" style="display: inline;">
                         <input type="hidden" name="csrf_token" value="{{ csrfToken }}">
                         <button type="submit" class="link-button danger" onclick="return confirm('Are you sure you want to delete this company?');">Delete</button>
                         </form> */}}
                </td>
            </tr>
            {{ end }}
        </tbody>
    </table>
    {{ else }}
    <div class="empty-state">
        <p>No companies found</p>
        {{ if search }}
        <p>No results for "{{ search }}"</p>
        <a href="/companies" role="button" class="secondary">Clear search</a>
        {{ else }}
        <a href="/companies/create" role="button">Register your first company</a>
        {{ end }}
    </div>
    {{ end }}

    {{/* Add pagination if needed */}}
</article>
{{ end }}
