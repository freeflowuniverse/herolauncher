extends layout

block content
  article
    header
      h2 Add New Shareholder
      p Register a new shareholder in the Freezone
    
    | {{if .formErrors}}
    .form-errors
      h4 Please correct the following errors:
      ul
        | {{range .formErrors}}
        li {{.}}
        | {{end}}
    | {{end}}
    
    form(action="/shareholders/create" method="post")
      | {{if .csrfToken}}
      input(type="hidden" name="csrf_token" value="{{.csrfToken}}")
      | {{end}}
      
      .grid
        div
          label(for="name") Full Name
          input(type="text" id="name" name="name" placeholder="Enter shareholder name" value="{{.form.Name}}")
        
        div
          label(for="email") Email
          input(type="email" id="email" name="email" placeholder="shareholder@example.com" value="{{.form.Email}}")
      
      .grid
        div
          label(for="phone") Phone
          input(type="tel" id="phone" name="phone" placeholder="+1 234 567 8900" value="{{.form.Phone}}")
        
        div
          label(for="address") Address
          input(type="text" id="address" name="address" placeholder="Shareholder address" value="{{.form.Address}}")
      
      div
        label(for="identification") Identification Number
        input(type="text" id="identification" name="identification" placeholder="ID or Passport number" value="{{.form.Identification}}")
      
      fieldset
        legend Additional Information
        .grid
          div
            label(for="nationality") Nationality
            input(type="text" id="nationality" name="nationality" placeholder="Shareholder nationality" value="{{.form.Nationality}}")
          
          div
            label(for="tax_id") Tax ID
            input(type="text" id="tax_id" name="tax_id" placeholder="Tax identification number" value="{{.form.TaxID}}")
        
        div
          label(for="notes") Notes
          textarea(id="notes" name="notes" placeholder="Additional notes about the shareholder" rows="3") {{.form.Notes}}
      
      .form-actions
        button(type="submit" role="button") Add Shareholder
        a(href="/shareholders" role="button" class="secondary") Cancel
