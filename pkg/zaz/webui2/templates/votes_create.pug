extends layout

block content
  article
    header
      h2 Create New Vote
      p Create a new vote or resolution for a company
    
    | {{if .formErrors}}
    .form-errors
      h4 Please correct the following errors:
      ul
        | {{range .formErrors}}
        li {{.}}
        | {{end}}
    | {{end}}
    
    form(action="/votes/create" method="post")
      | {{if .csrfToken}}
      input(type="hidden" name="csrf_token" value="{{.csrfToken}}")
      | {{end}}
      
      .grid
        div
          label(for="company_id") Company
          select(id="company_id" name="company_id")
            option(value="") Select company
            | {{range .companies}}
            option(value="{{.ID}}") {{.Name}}
            | {{end}}
        
        div
          label(for="title") Vote Title
          input(type="text" id="title" name="title" placeholder="Enter vote title" value="{{.form.Title}}")
      
      div
        label(for="description") Description
        textarea(id="description" name="description" placeholder="Detailed description of the vote or resolution" rows="4") {{.form.Description}}
      
      .grid
        div
          label(for="vote_type") Vote Type
          select(id="vote_type" name="vote_type")
            option(value="") Select vote type
            option(value="resolution") Board Resolution
            option(value="shareholder") Shareholder Vote
            option(value="election") Board Election
            option(value="other") Other
        
        div
          label(for="majority_type") Majority Type
          select(id="majority_type" name="majority_type")
            option(value="") Select majority type
            option(value="simple") Simple Majority (>50%)
            option(value="two_thirds") Two-Thirds Majority (≥66.67%)
            option(value="three_quarters") Three-Quarters Majority (≥75%)
            option(value="unanimous") Unanimous (100%)
      
      .grid
        div
          label(for="start_date") Start Date
          input(type="date" id="start_date" name="start_date" value="{{.form.StartDate}}")
        
        div
          label(for="deadline") Deadline
          input(type="date" id="deadline" name="deadline" value="{{.form.Deadline}}")
      
      fieldset
        legend Vote Options
        
        .vote-options
          .vote-option
            .grid
              div
                label(for="option_1") Option 1
                input(type="text" id="option_1" name="options[]" placeholder="Enter option" value="{{if and .form.Options (gt (len .form.Options) 0)}}{{index .form.Options 0}}{{end}}")
              
              div
                label(for="option_1_description") Description (Optional)
                input(type="text" id="option_1_description" name="option_descriptions[]" placeholder="Brief description" value="{{if and .form.OptionDescriptions (gt (len .form.OptionDescriptions) 0)}}{{index .form.OptionDescriptions 0}}{{end}}")
          
          .vote-option
            .grid
              div
                label(for="option_2") Option 2
                input(type="text" id="option_2" name="options[]" placeholder="Enter option" value="{{if and .form.Options (gt (len .form.Options) 1)}}{{index .form.Options 1}}{{end}}")
              
              div
                label(for="option_2_description") Description (Optional)
                input(type="text" id="option_2_description" name="option_descriptions[]" placeholder="Brief description" value="{{if and .form.OptionDescriptions (gt (len .form.OptionDescriptions) 1)}}{{index .form.OptionDescriptions 1}}{{end}}")
        
        button.add-option(type="button") + Add Another Option
      
      fieldset
        legend Eligible Voters
        
        div
          label(for="voter_type") Who Can Vote
          select(id="voter_type" name="voter_type")
            option(value="") Select voter type
            option(value="all_shareholders") All Shareholders
            option(value="board_members") Board Members Only
            option(value="specific") Specific Shareholders
        
        .specific-voters(style="display: none;")
          label Select Specific Shareholders
          | {{range .shareholders}}
          .checkbox-item
            input(type="checkbox" id="voter_{{.ID}}" name="specific_voters[]" value="{{.ID}}")
            label(for="voter_{{.ID}}") {{.Name}} ({{.Email}})
          | {{end}}
      
      .form-actions
        button(type="submit" role="button") Create Vote
        a(href="/votes" role="button" class="secondary") Cancel

block scripts
  script.
    // Add more vote options
    document.querySelector('.add-option').addEventListener('click', function() {
      const voteOptions = document.querySelector('.vote-options');
      const optionCount = voteOptions.querySelectorAll('.vote-option').length + 1;
      
      const newOption = document.createElement('div');
      newOption.className = 'vote-option';
      newOption.innerHTML = `
        <div class="grid">
          <div>
            <label for="option_${optionCount}">Option ${optionCount}</label>
            <input type="text" id="option_${optionCount}" name="options[]" placeholder="Enter option" required>
          </div>
          <div>
            <label for="option_${optionCount}_description">Description (Optional)</label>
            <input type="text" id="option_${optionCount}_description" name="option_descriptions[]" placeholder="Brief description">
          </div>
        </div>
      `;
      
      voteOptions.appendChild(newOption);
    });
    
    // Toggle specific voters section
    document.getElementById('voter_type').addEventListener('change', function() {
      const specificVoters = document.querySelector('.specific-voters');
      
      if (this.value === 'specific') {
        specificVoters.style.display = 'block';
      } else {
        specificVoters.style.display = 'none';
      }
    });
