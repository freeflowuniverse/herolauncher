{{ extends "layout.jet" }}

{{ block content() }}
<article>
    <header>
        <h2>User Management</h2>
        <p>Manage users and permissions in the Freezone</p>
    </header>

    <div class="action-bar">
        <a href="/admin/users/create" role="button">Add User</a>
        <form class="search-form" action="/admin/users" method="get">
            <input type="search" name="search" placeholder="Search users..." value="{{ search }}">
            <button type="submit">Search</button>
        </form>
    </div>

    {{ if users }}
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th>Last Login</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {{ range users }}
            <tr>
                <td>{{ .ID }}</td>
                <td>{{ .Name }}</td>
                <td>{{ .Email }}</td>
                <td>{{ .Role }}</td>
                <td>{{ .Status }}</td>
                <td>{{ .LastLogin }}</td>
                <td class="actions">
                    <a href="/admin/users/{{ .ID }}" title="View Details">Details</a>
                    <a href="/admin/users/{{ .ID }}/edit" title="Edit User">Edit</a>
                    {{ if .Status == "Active" }}
                    <a href="/admin/users/{{ .ID }}/disable" title="Disable User" class="warning-action">Disable</a>
                    {{ else }}
                    <a href="/admin/users/{{ .ID }}/enable" title="Enable User">Enable</a>
                    {{ end }}
                </td>
            </tr>
            {{ end }}
        </tbody>
    </table>
    {{ else }}
    <div class="empty-state">
        <p>No users found</p>
        {{ if search }}
        <p>No results for "{{ search }}"</p>
        <a href="/admin/users">Clear search</a>
        {{ else }}
        <a href="/admin/users/create" role="button">Add your first user</a>
        {{ end }}
    </div>
    {{ end }}

    <article>
        <header>
            <h3>Role Management</h3>
        </header>

        <div class="grid">
            <div>
                <h4>Available Roles</h4>
                {{ if roles }}
                <table>
                    <thead>
                        <tr>
                            <th>Role</th>
                            <th>Users</th>
                            <th>Permissions</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{ range roles }}
                        <tr>
                            <td>{{ .Name }}</td>
                            <td>{{ .UserCount }}</td>
                            <td>{{ .PermissionCount }}</td>
                            <td class="actions">
                                <a href="/admin/roles/{{ .ID }}/edit" title="Edit Role">Edit</a>
                                {{ if .UserCount > 0 }}
                                <a href="/admin/roles/{{ .ID }}/users" title="View Users">Users</a>
                                {{ end }}
                            </td>
                        </tr>
                        {{ end }}
                    </tbody>
                </table>
                {{ else }}
                <p class="no-data">No roles defined.</p>
                {{ end }}
            </div>

            <div>
                <h4>User Activity</h4>
                <div class="chart-container">
                    <div id="user-activity-chart" style="width: 100%; height: 300px;"></div>
                </div>
            </div>
        </div>
    </article>
</article>
{{ end }}

{{ block scripts() }}
<script src="https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js"></script>
<script>
    // Initialize user activity chart
    document.addEventListener('DOMContentLoaded', function() {
        // Check if echarts is loaded
        if (typeof echarts === 'undefined') {
            console.error('ECharts library is not loaded.');
            return;
        }
        const chartDom = document.getElementById('user-activity-chart');
        if (!chartDom) {
             console.error('Chart container element not found.');
             return;
        }
        const activityChart = echarts.init(chartDom);

        // Example data - replace with actual data fetched from the server
        const activityOption = {
            tooltip: {
                trigger: 'axis',
                axisPointer: {
                    type: 'cross',
                    label: {
                        backgroundColor: '#6a7985'
                    }
                }
            },
            legend: {
                data: ['Logins', 'Registrations', 'Actions']
            },
            grid: {
                left: '3%',
                right: '4%',
                bottom: '3%',
                containLabel: true
            },
            xAxis: [
                {
                    type: 'category',
                    boundaryGap: false,
                    data: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'] // Example days
                }
            ],
            yAxis: [
                {
                    type: 'value'
                }
            ],
            series: [
                {
                    name: 'Logins',
                    type: 'line',
                    stack: 'Total',
                    areaStyle: {},
                    emphasis: {
                        focus: 'series'
                    },
                    data: [120, 132, 101, 134, 90, 230, 210] // Example data
                },
                {
                    name: 'Registrations',
                    type: 'line',
                    stack: 'Total',
                    areaStyle: {},
                    emphasis: {
                        focus: 'series'
                    },
                    data: [20, 12, 11, 34, 20, 30, 10] // Example data
                },
                {
                    name: 'Actions',
                    type: 'line',
                    stack: 'Total',
                    areaStyle: {},
                    emphasis: {
                        focus: 'series'
                    },
                    data: [150, 232, 201, 154, 190, 330, 410] // Example data
                }
            ]
        };

        activityChart.setOption(activityOption);

        // Add resize listener
         window.addEventListener('resize', activityChart.resize);
    });
</script>
{{ end }}
