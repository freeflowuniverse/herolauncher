extends layout

block content
  article
    header
      h2 Companies
      p Manage all companies registered in the Freezone

    p TEST

    .action-bar
      a(href="/companies/create" role="button") Create Company
      form.search-form(action="/companies" method="get")
        input(type="search" name="search" placeholder="Search companies..." value="{{.search}}")
        button(type="submit") Search

    p TEST

    // Debug info
    p Found {{.count}} companies in the database
    
    | {{if .companies}}
    table
      thead
        tr
          th ID
          th Name
          th Status
          th Industry
          th Actions
      tbody
        | {{range .companies}}
        tr
          td {{.ID}}
          td {{.Name}}
          td {{.Status}}
          td {{.Industry}}
          td.actions
            a(href="/companies/{{.ID}}" title="View Details") Details
            a(href="/companies/{{.ID}}/edit" title="Edit Company") Edit
        | {{end}}
    | {{else}}
    .empty-state
      p No companies found
      | {{if .search}}
      p No results for "{{.search}}"
      a(href="/companies") Clear search
      | {{else}}
      a(href="/companies/create" role="button") Register your first company
      | {{end}}
    | {{end}}
