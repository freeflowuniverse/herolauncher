extends layout

block content
  article
    header
      h2 Companies
      p Manage all companies registered in the Freezone
    
    .action-bar
      a(href="/companies/create" role="button")
      form.search-form(action="/companies" method="get")
        input(type="search" name="search" placeholder="Search companies...")
        button(type="submit") Search
    
    if companies
      table
        thead
          tr
            th ID
            th Name
            th Registration Date
            th Status
            th Industry
            th Shareholders
            th Actions
        tbody
          each company in companies
            tr
              td= company.ID
              td= company.Name
              td= company.IncorporationDate
              td
                span(class=`status ${company.Status.toLowerCase()}`)= company.Status
              td= company.Industry
              td= company.Shareholders ? company.Shareholders.length : 0
              td.actions
                a.action-button(href=`/companies/${company.ID}` title="View Details") Details
                a.action-button(href=`/companies/${company.ID}/edit` title="Edit Company") Edit
                a.action-button(href=`/companies/${company.ID}/shareholders` title="Manage Shareholders") Shareholders
    else
      .empty-state
        p No companies found
        if search
          p No results for "#{search}"
          a(href="/companies") Clear search
        else
          a(href="/companies/create" role="button") Register your first company
