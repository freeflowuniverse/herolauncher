extends layout

block content
  article
    header
      h2 Schedule Board Meeting
      p Create a new board meeting for a company
    
    | {{if .error}}
    .form-errors
      h4 Please correct the following errors:
      p {{.error}}
    | {{end}}
    
    form(action="/boardmeetings/create" method="post")
      | {{if .csrfToken}}
      input(type="hidden" name="csrf_token" value="{{.csrfToken}}")
      | {{end}}
      
      .grid
        div
          label(for="title") Meeting Title
          input(type="text" id="title" name="title" placeholder="Enter meeting title" value="{{.form.Title}}")
        
        div
          label(for="company_id") Company
          select(id="company_id" name="company_id")
            option(value="") Select company
            | {{range .companies}}
            option(value="{{.ID}}") {{.Name}}
            | {{end}}
      
      .grid
        div
          label(for="date") Meeting Date
          input(type="date" id="date" name="date" value="{{.form.Date}}")
        
        div
          label(for="location") Location
          input(type="text" id="location" name="location" placeholder="Meeting location" value="{{.form.Location}}")
      
      div
        label(for="description") Description
        textarea(id="description" name="description" placeholder="Meeting agenda and details" rows="4") {{.form.Description}}
      
      fieldset
        legend Attendees
        p Attendees can be added after creating the meeting
      
      .form-actions
        button(type="submit" role="button") Schedule Meeting
        a(href="/boardmeetings" role="button" class="secondary") Cancel
