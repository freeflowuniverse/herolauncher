extends layout

block content
  article
    header
      h2 Freezone Manager Dashboard
      p Welcome to the Freezone Management System
    
    .grid
      div
        article
          header
            h3 Company Statistics
          
          .grid
            div
              h4 Total Companies
              p
                strong {{.companiesCount}}
                span  registered
            
            div
              h4 Active Companies
              p
                strong {{.activeCompaniesCount}}
                span  companies
            
            div
              h4 Total Shareholders
              p
                strong {{.shareholdersCount}}
                span  shareholders
      
      div
        article
          header
            h3 Recent Activity
          
          | {{if .recentActivities}}
          ul
            | {{range .recentActivities}}
            li {{.Description}} ({{.TimeAgo}})
            | {{end}}
          | {{else}}
          p.no-data No recent activities to display.
          | {{end}}
    
    article
      header
        h3 Quick Actions
      
      .grid
        div
          a(href="/companies/create" role="button") Register Company
        
        div
          a(href="/boardmeetings/create" role="button" class="secondary") Schedule Meeting
        
        div
          a(href="/votes/create" role="button" class="contrast") Create Vote
          
    | {{if .upcomingMeetings}}
    article
      header
        h3 Upcoming Meetings
      
      table
        thead
          tr
            th Date
            th Company
            th Title
            th Actions
        tbody
          | {{range .upcomingMeetings}}
          tr
            td {{.Date}}
            td {{.Company.Name}}
            td {{.Title}}
            td
              a.action-button(href="/boardmeetings/{{.ID}}" title="View Details") Details
          | {{end}}
    | {{end}}
