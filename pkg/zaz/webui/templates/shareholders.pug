extends layout

block content
  article
    header
      h2 Shareholders
      p Manage all shareholders registered in the Freezone

    .action-bar
      a(href="/shareholders/create" role="button") Add Shareholder
      form.search-form(action="/shareholders" method="get")
        input(type="search" name="search" placeholder="Search shareholders..." value="{{.search}}")
        button(type="submit") Search
    
    | {{if .shareholders}}
    table
      thead
        tr
          th ID
          th Name
          th Email
          th Companies
          th Total Shares
          th Actions
      tbody
        | {{range .shareholders}}
        tr
          td {{.ID}}
          td {{.Name}}
          td {{if .ContactInfo}}{{.ContactInfo.Email}}{{else}}N/A{{end}}
          td {{.CompaniesCount}}
          td {{.TotalShares}}
          td.actions
            a(href="/shareholders/{{.ID}}" title="View Details") Details
            a(href="/shareholders/{{.ID}}/edit" title="Edit Shareholder") Edit
        | {{end}}
    | {{else}}
    .empty-state
      p No shareholders found
      | {{if .search}}
      p No results for "{{.search}}"
      a(href="/shareholders") Clear search
      | {{else}}
      a(href="/shareholders/create" role="button") Add your first shareholder
      | {{end}}
    | {{end}}
