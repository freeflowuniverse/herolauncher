extends layout

block content
  article.compact
    header.slim-header
      h2 Board Meeting Details
      .header-actions.button-group
        | {{if eq .meeting.Status "Scheduled"}}
        a(href="/boardmeetings/{{.meeting.ID}}/start" role="button" class="primary small") Start Meeting
        | {{end}}
        | {{if eq .meeting.Status "In Progress"}}
        a(href="/boardmeetings/{{.meeting.ID}}/minutes" role="button" class="primary small") Record Minutes
        a(href="/boardmeetings/{{.meeting.ID}}/end" role="button" class="secondary small") End Meeting
        | {{end}}
        | {{if eq .meeting.Status "Completed"}}
        a(href="/boardmeetings/{{.meeting.ID}}/minutes" role="button" class="secondary small") View Minutes
        | {{end}}
        a(href="/boardmeetings" role="button" class="outline small") Back to List
        
    .meeting-info.grid
      .meeting-details
        h3 {{.meeting.Title}}
        
        p.company
          strong Company: 
          a(href="/companies/{{.meeting.CompanyID}}") {{.meeting.CompanyName}}
        p.status
          strong Status: 
          span(class="status {{.meeting.Status}}") {{.meeting.Status}}
        p.date
          strong Date: 
          span {{.meeting.Date.Format "2006-01-02"}}
        p.location
          strong Location: 
          span {{.meeting.Location}}
        
      .meeting-description
        h3 Description
        p {{.meeting.Description}}
      
    section.attendees
      h3 Attendees
      
      | {{if .meeting.Attendees}}
      table
        thead
          tr
            th Name
            th Role
            th Status
            th Actions
        tbody
          | {{range .meeting.Attendees}}
          tr
            td {{.Name}}
            td {{.Role}}
            td {{.Status}}
            td.actions
              | {{if eq .Status "Invited"}}
              a.action-button(href="/boardmeetings/{{$.meeting.ID}}/attendees/{{.ID}}/confirm" title="Confirm Attendance") Confirm
              | {{end}}
          | {{end}}
      | {{else}}
      p.no-data No attendees added to this meeting.
      | {{end}}
      
      | {{if eq .meeting.Status "Scheduled"}}
      .add-attendee
        h4 Add Attendee
        form(action="/boardmeetings/{{.meeting.ID}}/attendees/add" method="post")
          | {{if .csrfToken}}
          input(type="hidden" name="csrf_token" value="{{.csrfToken}}")
          | {{end}}
          
          .grid
            div
              label(for="attendee_id") Select Shareholder
              select(id="attendee_id" name="attendee_id")
                option(value="") Select an attendee
                | {{range .availableAttendees}}
                option(value="{{.ID}}") {{.Name}} ({{.Role}})
                | {{end}}
            
            div
              label(for="role") Role in Meeting
              select(id="role" name="role")
                option(value="") Select role
                option(value="Chairman") Chairman
                option(value="Secretary") Secretary
                option(value="Director") Director
                option(value="Member") Member
                option(value="Observer") Observer
          
          button(type="submit" role="button" class="small") Add Attendee
      | {{end}}
      
    section.agenda
      h3 Agenda Items
      
      | {{if .meeting.AgendaItems}}
      table
        thead
          tr
            th Item
            th Presenter
            th Duration
            th Status
        tbody
          | {{range $index, $item := .meeting.AgendaItems}}
          tr
            td {{$item.Title}}
            td {{$item.Presenter}}
            td {{$item.Duration}} min
            td {{$item.Status}}
          | {{end}}
      | {{else}}
      p.no-data No agenda items added to this meeting.
      | {{end}}
      
      | {{if eq .meeting.Status "Scheduled"}}
      .add-agenda-item
        h4 Add Agenda Item
        form(action="/boardmeetings/{{.meeting.ID}}/agenda/add" method="post")
          | {{if .csrfToken}}
          input(type="hidden" name="csrf_token" value="{{.csrfToken}}")
          | {{end}}
          
          .grid
            div
              label(for="agenda_title") Title
              input(type="text" id="agenda_title" name="agenda_title" placeholder="Agenda item title")
            
            div
              label(for="agenda_presenter") Presenter
              input(type="text" id="agenda_presenter" name="agenda_presenter" placeholder="Who will present this item")
          
          .grid
            div
              label(for="agenda_duration") Duration (minutes)
              input(type="number" id="agenda_duration" name="agenda_duration" min="1" value="15")
            
            div
              label(for="agenda_description") Description
              input(type="text" id="agenda_description" name="agenda_description" placeholder="Brief description")
          
          button(type="submit" role="button" class="small") Add Item
      | {{end}}
      
    | {{if .meeting.RelatedDocuments}}
    section.documents
      h3 Related Documents
      
      ul.document-list
        | {{range .meeting.RelatedDocuments}}
        li
          a(href="{{.URL}}" target="_blank") {{.Name}}
          span.document-type ({{.Type}})
        | {{end}}
    | {{end}}
    
    | {{if eq .meeting.Status "Completed"}}
    section.resolutions
      h3 Resolutions
      
      | {{if .meeting.Resolutions}}
      .resolutions-list
        | {{range .meeting.Resolutions}}
        article.resolution
          header
            h4 {{.Title}}
          
          p {{.Description}}
          
          p.resolution-result
            strong Result: 
            span {{.Result}}
          
          p.resolution-votes
            strong Votes: 
            span For: {{.VotesFor}}, Against: {{.VotesAgainst}}, Abstained: {{.VotesAbstained}}
        | {{end}}
      | {{else}}
      p.no-data No resolutions recorded for this meeting.
      | {{end}}
    | {{end}}

block scripts
  script.
    // Helper function to add ordinal suffix to numbers
    function ordinalSuffix(i) {
      const j = i % 10,
            k = i % 100;
      if (j == 1 && k != 11) {
        return i + "st";
      }
      if (j == 2 && k != 12) {
        return i + "nd";
      }
      if (j == 3 && k != 13) {
        return i + "rd";
      }
      return i + "th";
    }
    
    // Format dates in a more readable format
    document.addEventListener('DOMContentLoaded', function() {
      // Format meeting date
      const dateElement = document.querySelector('.meeting-details .date span');
      if (dateElement) {
        const dateText = dateElement.textContent.trim();
        if (dateText) {
          try {
            const date = new Date(dateText);
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' };
            dateElement.textContent = date.toLocaleDateString('en-US', options);
          } catch (e) {
            console.error('Error formatting date:', e);
          }
        }
      }
    });
