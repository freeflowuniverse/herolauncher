extends layout

block content
  article.error-page
    header
      h2 Error
      p Something went wrong
    
    .error-container
      | {{if .error}}
      p.error-message {{.error}}
      | {{else}}
      p.error-message An unexpected error occurred.
      | {{end}}
    
    .error-actions
      a(href="/" role="button") Return to Dashboard
      | {{if .backUrl}}
      a(href="{{.backUrl}}" role="button" class="secondary") Go Back
      | {{end}}
