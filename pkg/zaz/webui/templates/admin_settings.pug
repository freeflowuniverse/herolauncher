extends layout

block content
  article
    header
      h2 System Settings
      p Configure the Freezone Manager system settings
    
    | {{if .success}}
    .flash-message.success
      .container
        p {{.success}}
    | {{end}}
    
    | {{if .error}}
    .flash-message.error
      .container
        p {{.error}}
    | {{end}}
    
    form(action="/admin/settings" method="post")
      | {{if .csrfToken}}
      input(type="hidden" name="csrf_token" value="{{.csrfToken}}")
      | {{end}}
      
      fieldset
        legend General Settings
        
        .grid
          div
            label(for="site_name") Site Name
            input(type="text" id="site_name" name="site_name" value="{{.settings.SiteName}}")
          
          div
            label(for="site_description") Site Description
            input(type="text" id="site_description" name="site_description" value="{{.settings.SiteDescription}}")
        
        .grid
          div
            label(for="company_email") Company Email
            input(type="email" id="company_email" name="company_email" value="{{.settings.CompanyEmail}}")
          
          div
            label(for="support_email") Support Email
            input(type="email" id="support_email" name="support_email" value="{{.settings.SupportEmail}}")
      
      fieldset
        legend Security Settings
        
        .grid
          div
            label(for="session_timeout") Session Timeout (minutes)
            input(type="number" id="session_timeout" name="session_timeout" min="5" value="{{.settings.SessionTimeout}}")
          
          div
            label(for="password_policy") Password Policy
            select(id="password_policy" name="password_policy")
              | {{if eq .settings.PasswordPolicy "basic"}}
              option(value="basic" selected="selected") Basic (min 8 chars)
              | {{else}}
              option(value="basic") Basic (min 8 chars)
              | {{end}}
              | {{if eq .settings.PasswordPolicy "standard"}}
              option(value="standard" selected="selected") Standard (min 8 chars, mixed case, numbers)
              | {{else}}
              option(value="standard") Standard (min 8 chars, mixed case, numbers)
              | {{end}}
              | {{if eq .settings.PasswordPolicy "strong"}}
              option(value="strong" selected="selected") Strong (min 12 chars, mixed case, numbers, symbols)
              | {{else}}
              option(value="strong") Strong (min 12 chars, mixed case, numbers, symbols)
              | {{end}}
        
        .grid
          div
            label(for="login_attempts") Max Login Attempts
            input(type="number" id="login_attempts" name="login_attempts" min="3" value="{{.settings.MaxLoginAttempts}}")
          
          div
            label(for="lockout_duration") Lockout Duration (minutes)
            input(type="number" id="lockout_duration" name="lockout_duration" min="5" value="{{.settings.LockoutDuration}}")
        
        .checkbox-item
          | {{if .settings.Enable2FA}}
          input(type="checkbox" id="enable_2fa" name="enable_2fa" checked="checked")
          | {{else}}
          input(type="checkbox" id="enable_2fa" name="enable_2fa")
          | {{end}}
          label(for="enable_2fa") Enable Two-Factor Authentication
      
      fieldset
        legend Email Settings
        
        .grid
          div
            label(for="smtp_host") SMTP Host
            input(type="text" id="smtp_host" name="smtp_host" value="{{.settings.SMTPHost}}")
          
          div
            label(for="smtp_port") SMTP Port
            input(type="number" id="smtp_port" name="smtp_port" value="{{.settings.SMTPPort}}")
        
        .grid
          div
            label(for="smtp_user") SMTP Username
            input(type="text" id="smtp_user" name="smtp_user" value="{{.settings.SMTPUser}}")
          
          div
            label(for="smtp_password") SMTP Password
            input(type="password" id="smtp_password" name="smtp_password" placeholder="Leave blank to keep current password")
        
        .checkbox-item
          | {{if .settings.SMTPSecure}}
          input(type="checkbox" id="smtp_secure" name="smtp_secure" checked="checked")
          | {{else}}
          input(type="checkbox" id="smtp_secure" name="smtp_secure")
          | {{end}}
          label(for="smtp_secure") Use Secure Connection (TLS)
      
      fieldset
        legend System Maintenance
        
        .grid
          div
            label(for="backup_frequency") Automatic Backup Frequency
            select(id="backup_frequency" name="backup_frequency")
              | {{if eq .settings.BackupFrequency "daily"}}
              option(value="daily" selected="selected") Daily
              | {{else}}
              option(value="daily") Daily
              | {{end}}
              | {{if eq .settings.BackupFrequency "weekly"}}
              option(value="weekly" selected="selected") Weekly
              | {{else}}
              option(value="weekly") Weekly
              | {{end}}
              | {{if eq .settings.BackupFrequency "monthly"}}
              option(value="monthly" selected="selected") Monthly
              | {{else}}
              option(value="monthly") Monthly
              | {{end}}
              | {{if eq .settings.BackupFrequency "never"}}
              option(value="never" selected="selected") Never
              | {{else}}
              option(value="never") Never
              | {{end}}
          
          div
            label(for="backup_retention") Backup Retention (days)
            input(type="number" id="backup_retention" name="backup_retention" min="1" value="{{.settings.BackupRetention}}")
        
        .grid
          div
            label(for="log_level") Log Level
            select(id="log_level" name="log_level")
              | {{if eq .settings.LogLevel "error"}}
              option(value="error" selected="selected") Error
              | {{else}}
              option(value="error") Error
              | {{end}}
              | {{if eq .settings.LogLevel "warning"}}
              option(value="warning" selected="selected") Warning
              | {{else}}
              option(value="warning") Warning
              | {{end}}
              | {{if eq .settings.LogLevel "info"}}
              option(value="info" selected="selected") Info
              | {{else}}
              option(value="info") Info
              | {{end}}
              | {{if eq .settings.LogLevel "debug"}}
              option(value="debug" selected="selected") Debug
              | {{else}}
              option(value="debug") Debug
              | {{end}}
          
          div
            label(for="log_retention") Log Retention (days)
            input(type="number" id="log_retention" name="log_retention" min="1" value="{{.settings.LogRetention}}")
      
      .form-actions
        button(type="submit" role="button") Save Settings
        button(type="button" id="test-email" class="secondary") Test Email
        a(href="/admin" role="button" class="outline") Cancel

block scripts
  script.
    // Test email functionality
    document.getElementById('test-email').addEventListener('click', function() {
      const emailSettings = {
        host: document.getElementById('smtp_host').value,
        port: document.getElementById('smtp_port').value,
        user: document.getElementById('smtp_user').value,
        password: document.getElementById('smtp_password').value,
        secure: document.getElementById('smtp_secure').checked,
        testEmail: document.getElementById('company_email').value
      };
      
      // Show loading state
      this.textContent = 'Sending...';
      this.disabled = true;
      
      // Send test email request
      fetch('/admin/settings/test-email', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': '{{.csrfToken}}'
        },
        body: JSON.stringify(emailSettings)
      })
      .then(response => response.json())
      .then(data => {
        // Reset button state
        this.textContent = 'Test Email';
        this.disabled = false;
        
        // Show result
        if (data.success) {
          alert('Test email sent successfully!');
        } else {
          alert('Failed to send test email: ' + data.error);
        }
      })
      .catch(error => {
        // Reset button state
        this.textContent = 'Test Email';
        this.disabled = false;
        
        // Show error
        alert('Error: ' + error.message);
      });
    });
