extends layout

block content
  article.register-form
    header
      h2 Register
      p Create a new account for the Freezone Manager
    
    form(action="/register", method="post")
      .grid
        div
          label(for="name") Full Name
          input(type="text", id="name", name="name", placeholder="John Doe", required)
        
        div
          label(for="email") Email
          input(type="email", id="email", name="email", placeholder="your.email@example.com", required)
      
      .grid
        div
          label(for="password") Password
          input(type="password", id="password", name="password", placeholder="Create a strong password", required)
        
        div
          label(for="confirm_password") Confirm Password
          input(type="password", id="confirm_password", name="confirm_password", placeholder="Confirm your password", required)
      
      .grid
        div
          label(for="company") Company (Optional)
          input(type="text", id="company", name="company", placeholder="Your company name")
        
        div
          label(for="role") Role (Optional)
          select(id="role", name="role")
            option(value="") Select your role
            option(value="company_admin") Company Administrator
            option(value="shareholder") Shareholder
            option(value="board_member") Board Member
            option(value="staff") Staff Member
      
      .form-actions
        button(type="submit", role="button") Register
        a(href="/login", role="button", class="secondary") Back to Login
      
      if error
        .error-message
          p= error
