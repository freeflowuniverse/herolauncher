extends layout

block content
  article.login-form
    header
      h2 Forgot Password
      p Enter your email to reset your password
    
    | {{if .success}}
    .success-message
      p {{.success}}
    | {{end}}
    
    | {{if .error}}
    .error-message
      p {{.error}}
    | {{end}}
    
    form(action="/forgot-password" method="post")
      | {{if .csrfToken}}
      input(type="hidden" name="csrf_token" value="{{.csrfToken}}")
      | {{end}}
      
      div
        label(for="email") Email
        input(type="email" id="email" name="email" placeholder="your.email@example.com" value="{{.form.Email}}")
      
      .form-actions
        button(type="submit" role="button") Reset Password
        a(href="/login" role="button" class="secondary") Back to Login
