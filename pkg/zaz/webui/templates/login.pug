extends layout

block content
  article.login-form
    header
      h2 Login
      p Please enter your credentials to access the Freezone Manager
    
    | {{if .error}}
    .error-message
      p {{.error}}
    | {{end}}
    
    form(action="/login" method="post")
      | {{if .csrfToken}}
      input(type="hidden" name="csrf_token" value="{{.csrfToken}}")
      | {{end}}
      
      .grid
        div
          label(for="email") Email
          input(type="email" id="email" name="email" placeholder="your.email@example.com" value="{{.form.Email}}")
        
        div
          label(for="password") Password
          input(type="password" id="password" name="password" placeholder="Enter your password")
      
      .form-actions
        button(type="submit" role="button") Login
        a(href="/register" role="button" class="secondary") Register
        a(href="/forgot-password") Forgot Password?
