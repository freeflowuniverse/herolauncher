extends layout

block content
  article
    header
      h2 Products
      p Manage all products available in the Freezone

    .action-bar
      a(href="/products/create" role="button") Add Product
      form.search-form(action="/products" method="get")
        input(type="search" name="search" placeholder="Search products..." value="{{.search}}")
        button(type="submit") Search
    
    | {{if .products}}
    table
      thead
        tr
          th ID
          th Name
          th Category
          th Price
          th Status
          th Actions
      tbody
        | {{range .products}}
        tr
          td {{.ID}}
          td {{.Name}}
          td {{.Category}}
          td {{printf "%.2f" .Price}} {{.Currency}}
          td {{.Status}}
          td.actions
            a(href="/products/{{.ID}}" title="View Details") Details
            a(href="/products/{{.ID}}/edit" title="Edit Product") Edit
        | {{end}}
    | {{else}}
    .empty-state
      p No products found
      | {{if .search}}
      p No results for "{{.search}}"
      a(href="/products") Clear search
      | {{else}}
      a(href="/products/create" role="button") Add your first product
      | {{end}}
    | {{end}}
