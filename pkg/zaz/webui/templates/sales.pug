extends layout

block content
  article
    header
      h2 Sales
      p Manage all sales transactions in the Freezone

    .action-bar
      a(href="/sales/create" role="button") Create Sale
      form.search-form(action="/sales" method="get")
        input(type="search" name="search" placeholder="Search sales..." value="{{.search}}")
        button(type="submit") Search
    
    | {{if .sales}}
    table
      thead
        tr
          th ID
          th Company
          th Type
          th Amount
          th Date
          th Status
          th Actions
      tbody
        | {{range .sales}}
        tr
          td {{.ID}}
          td {{.CompanyName}}
          td {{.Type}}
          td ${{.Amount}}
          td {{.Date}}
          td {{.Status}}
          td.actions
            a(href="/sales/{{.ID}}" title="View Details") Details
            | {{if ne .Status "Completed"}}
            a(href="/sales/{{.ID}}/edit" title="Edit Sale") Edit
            | {{end}}
        | {{end}}
    | {{else}}
    .empty-state
      p No sales found
      | {{if .search}}
      p No results for "{{.search}}"
      a(href="/sales") Clear search
      | {{else}}
      a(href="/sales/create" role="button") Create your first sale
      | {{end}}
    | {{end}}
