extends layout

block content
  article.compact
    header.slim-header
      h2 Shareholder Details
      .header-actions.button-group
        a(href="/shareholders/{{.shareholder.ID}}/edit" role="button" class="secondary small") Edit Shareholder
        a(href="/shareholders" role="button" class="outline small") Back to List
        
    .shareholder-info.grid
      .shareholder-profile
        h3 {{.shareholder.Name}}
        
        p.identification
          strong ID: 
          span {{.shareholder.ID}}
        p.company
          strong Company ID: 
          span {{.shareholder.CompanyID}}
        p.since
          strong Member Since: 
          span {{.shareholder.Since.Format "2006-01-02"}}
        p.type
          strong Type: 
          span {{.shareholder.Type}}
        
      .shareholder-shares
        h3 Share Information
        p.shares
          strong Shares: 
          span {{.shareholder.Shares}}
        p.percentage
          strong Percentage: 
          span {{printf "%.1f" .shareholder.Percentage}}%
        p.created
          strong Created At: 
          span {{.shareholder.CreatedAt.Format "2006-01-02"}}
        
      .shareholder-additional
        h3 Additional Information
        p Created: {{.shareholder.CreatedAt.Format "2006-01-02"}}
        p Updated: {{.shareholder.UpdatedAt.Format "2006-01-02"}}
      
    section.company-info
      h3 Company Information
      | {{if .company}}
      table
        thead
          tr
            th Company ID
            th Name
            th Industry
            th Status
            th Actions
        tbody
          tr
            td {{.company.ID}}
            td {{.company.Name}}
            td {{.company.Industry}}
            td {{.company.Status}}
            td.actions
              a.action-button(href="/companies/{{.company.ID}}" title="View Company Details") View Company
      | {{else}}
      p.no-data No companies associated with this shareholder.
      | {{end}}
      
    section.additional-info
      h3 Additional Information
      
      p This shareholder owns {{.shareholder.Shares}} shares ({{printf "%.1f" .shareholder.Percentage}}%) of the company.
      p Shareholder type: {{.shareholder.Type}}
      p Member since: {{.shareholder.Since.Format "2006-01-02"}}
