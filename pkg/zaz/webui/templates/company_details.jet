{{ extends "./layout" }}

{{ block content() }}
<article class="compact">
  <header class="slim-header">
    <h2>Company Details</h2>
    <div class="header-actions button-group">
      <a href="/companies/{{ .company.ID }}/edit" role="button" class="secondary small">Edit Company</a>
      <a href="/companies" role="button" class="outline small">Back to List</a>
    </div>
  </header>

  <div class="company-info grid">
    <div class="company-profile">
      <h3>{{ .company.Name }}</h3>

      <p class="registration">
        <strong>Registration #: </strong>
        <span>{{ .company.RegistrationNumber }}</span>
      </p>
      <p class="incorporation">
        <strong>Incorporated: </strong>
        <span>{{ .company.IncorporationDate.Format "2006-01-02" }}</span>
      </p>
      <p class="status">
        <strong>Status: </strong>
        <span class="status">{{ .company.Status }}</span>
      </p>
      <p class="business-type">
        <strong>Business Type: </strong>
        <span>{{ .company.BusinessType }}</span>
      </p>
      <p class="industry">
        <strong>Industry: </strong>
        <span>{{ .company.Industry }}</span>
      </p>
    </div>

    <div class="company-contact">
      <h3>Contact Information</h3>
      <p>
        <strong>Email: </strong>
        <a href="mailto:{{ .company.Email }}">{{ .company.Email }}</a>
      </p>
      <p>
        <strong>Phone: </strong>
        <span>{{ .company.Phone }}</span>
      </p>
      <p>
        <strong>Website: </strong>
        {{ if .company.Website }}
        <a href="{{ .company.Website }}" target="_blank">{{ .company.Website }}</a>
        {{ else }}
        <span>Not provided</span>
        {{ end }}
      </p>
    </div>

    <div class="company-description">
      <h3>Description</h3>
      {{ if .company.Description }}
      <p>{{ .company.Description }}</p>
      {{ else }}
      <p>No description provided.</p>
      {{ end }}
    </div>
  </div>

  <section class="shareholders">
    <h3>Shareholders</h3>
    {{ if .company.Shareholders }}
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Shares</th>
          <th>Percentage</th>
          <th>Since</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {{ range .company.Shareholders }}
        <tr>
          <td>{{ .Name }}</td>
          <td>{{ .Shares }}</td>
          <td>{{ printf "%.1f" .Percentage }}%</td>
          <td>{{ .Since.Format "2006-01-02" }}</td>
          <td class="actions">
            <a href="/shareholders/{{ .ID }}" title="View Details" class="action-button">Details</a>
          </td>
        </tr>
        {{ end }}
      </tbody>
    </table>
    {{ else }}
    <p class="no-data">No shareholders registered for this company.</p>
    {{ end }}
  </section>

  <section class="board-meetings">
    <h3>Board Meetings</h3>
    <a href="/companies/{{ .company.ID }}/boardmeetings/schedule" role="button" class="outline">Schedule Meeting</a>

    {{ if .boardMeetings }}
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Title</th>
          <th>Attendees</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {{ range .boardMeetings }}
        <tr>
          <td>{{ .Date.Format "2006-01-02" }}</td>
          <td>{{ .Title }}</td>
          <td>{{ len .Attendees }}</td>
          <td>{{ .Status }}</td>
          <td class="actions">
            <a href="/boardmeetings/{{ .ID }}" title="View Details" class="action-button">Details</a>
            {{ if eq .Status "Completed" }}
            <a href="/boardmeetings/{{ .ID }}/minutes" title="Meeting Minutes" class="action-button">Minutes</a>
            {{ end }}
          </td>
        </tr>
        {{ end }}
      </tbody>
    </table>
    {{ else }}
    <p class="no-data">No board meetings scheduled for this company.</p>
    {{ end }}
  </section>
</article>
{{ end }}