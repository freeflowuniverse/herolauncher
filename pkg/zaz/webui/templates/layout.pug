doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Freezone Manager
    link(rel="icon", href="/img/freezone-icon.svg", type="image/svg+xml")
    link(rel="shortcut icon", href="/favicon.ico")
    link(rel="stylesheet", href="/css/pico.min.css")
    link(rel="stylesheet", href="/css/freezone.css")
    link(rel="stylesheet", href="/css/unpoly.min.css")
  
  body
    .app-container
      include partials/header
      
      .page-container
        include partials/sidebar
        
        main.main-content
          .container
            block content
      
      footer.app-footer
        .container
          p &copy; 2025 Freezone Manager - A FreeFlow Universe Project
    
    script(src="/js/unpoly.min.js")
    script(src="/js/echarts/echarts.min.js")
    script(src="/js/freezone.js")
    block scripts
