extends layout

block content
  article
    header
      h2 Create New Company
      p Register a new company in the Freezone
    
    form(action="/companies/create", method="post")
      .grid
        div
          label(for="name") Company Name
          input(type="text", id="name", name="name", placeholder="Enter company name", required)
        
        div
          label(for="registration_number") Registration Number
          input(type="text", id="registration_number", name="registration_number", placeholder="e.g. BRN12345678")
      
      .grid
        div
          label(for="incorporation_date") Incorporation Date
          input(type="date", id="incorporation_date", name="incorporation_date", required)
        
        div
          label(for="fiscal_year_end") Fiscal Year End
          select(id="fiscal_year_end", name="fiscal_year_end")
            option(value="") Select month
            option(value="01") January
            option(value="02") February
            option(value="03") March
            option(value="04") April
            option(value="05") May
            option(value="06") June
            option(value="07") July
            option(value="08") August
            option(value="09") September
            option(value="10") October
            option(value="11") November
            option(value="12") December
      
      fieldset
        legend Contact Information
        .grid
          div
            label(for="email") Email
            input(type="email", id="email", name="email", placeholder="company@example.com")
          
          div
            label(for="phone") Phone
            input(type="tel", id="phone", name="phone", placeholder="+1 234 567 8900")
        
        .grid
          div
            label(for="website") Website
            input(type="url", id="website", name="website", placeholder="https://example.com")
          
          div
            label(for="address") Address
            textarea(id="address", name="address", placeholder="Company Address", rows="3")
      
      fieldset
        legend Company Details
        .grid
          div
            label(for="business_type") Business Type
            select(id="business_type", name="business_type")
              option(value="") Select type
              option(value="llc") Limited Liability Company
              option(value="corp") Corporation
              option(value="partnership") Partnership
              option(value="sole_prop") Sole Proprietorship
              option(value="other") Other
          
          div
            label(for="industry") Industry
            select(id="industry", name="industry")
              option(value="") Select industry
              option(value="tech") Technology
              option(value="finance") Finance
              option(value="healthcare") Healthcare
              option(value="retail") Retail
              option(value="manufacturing") Manufacturing
              option(value="services") Services
              option(value="other") Other
        
        div
          label(for="description") Company Description
          textarea(id="description", name="description", placeholder="Brief description of the company", rows="4")
      
      .form-actions
        button(type="submit", role="button") Create Company
        a(href="/companies", role="button", class="secondary") Cancel
