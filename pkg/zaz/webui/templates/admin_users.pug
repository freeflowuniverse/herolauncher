extends layout

block content
  article
    header
      h2 User Management
      p Manage users and permissions in the Freezone
    
    .action-bar
      a(href="/admin/users/create" role="button") Add User
      form.search-form(action="/admin/users" method="get")
        input(type="search" name="search" placeholder="Search users..." value="{{.search}}")
        button(type="submit") Search
    
    | {{if .users}}
    table
      thead
        tr
          th ID
          th Name
          th Email
          th Role
          th Status
          th Last Login
          th Actions
      tbody
        | {{range .users}}
        tr
          td {{.ID}}
          td {{.Name}}
          td {{.Email}}
          td {{.Role}}
          td {{.Status}}
          td {{.LastLogin}}
          td.actions
            a(href="/admin/users/{{.ID}}" title="View Details") Details
            a(href="/admin/users/{{.ID}}/edit" title="Edit User") Edit
            | {{if eq .Status "Active"}}
            a(href="/admin/users/{{.ID}}/disable" title="Disable User" class="warning-action") Disable
            | {{else}}
            a(href="/admin/users/{{.ID}}/enable" title="Enable User") Enable
            | {{end}}
        | {{end}}
    | {{else}}
    .empty-state
      p No users found
      | {{if .search}}
      p No results for "{{.search}}"
      a(href="/admin/users") Clear search
      | {{else}}
      a(href="/admin/users/create" role="button") Add your first user
      | {{end}}
    | {{end}}
    
    article
      header
        h3 Role Management
      
      .grid
        div
          h4 Available Roles
          
          | {{if .roles}}
          table
            thead
              tr
                th Role
                th Users
                th Permissions
                th Actions
            tbody
              | {{range .roles}}
              tr
                td {{.Name}}
                td {{.UserCount}}
                td {{.PermissionCount}}
                td.actions
                  a(href="/admin/roles/{{.ID}}/edit" title="Edit Role") Edit
                  | {{if gt .UserCount 0}}
                  a(href="/admin/roles/{{.ID}}/users" title="View Users") Users
                  | {{end}}
              | {{end}}
          | {{else}}
          p.no-data No roles defined.
          | {{end}}
        
        div
          h4 User Activity
          
          .chart-container
            #user-activity-chart(style="width: 100%; height: 300px;")

block scripts
  script.
    // Initialize user activity chart
    document.addEventListener('DOMContentLoaded', function() {
      const activityChart = echarts.init(document.getElementById('user-activity-chart'));
      
      const activityOption = {
        tooltip: {
          trigger: 'axis',
          axisPointer: {
            type: 'shadow'
          }
        },
        xAxis: {
          type: 'category',
          data: [{{range .activityStats.Days}}'{{.}}',{{end}}]
        },
        yAxis: {
          type: 'value'
        },
        series: [
          {
            name: 'Active Users',
            type: 'line',
            data: [{{range .activityStats.ActiveUsers}}{{.}},{{end}}],
            markPoint: {
              data: [
                { type: 'max', name: 'Max' },
                { type: 'min', name: 'Min' }
              ]
            }
          }
        ]
      };
      
      activityChart.setOption(activityOption);
      
      // Resize chart when window size changes
      window.addEventListener('resize', function() {
        activityChart.resize();
      });
      
      // Confirm user disable/enable
      document.querySelectorAll('.warning-action').forEach(function(link) {
        link.addEventListener('click', function(e) {
          if (!confirm('Are you sure you want to disable this user?')) {
            e.preventDefault();
          }
        });
      });
    });
