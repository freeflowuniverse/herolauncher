{{ extends "./layout.jet" }}

{{ block "content" }}
  <article>
    <header>
      <h2>Add Shareholder to Company</h2>
      <p>Add an existing or new shareholder to {{.company.Name}}</p>
    </header>

    {{- if .formErrors }}
    <div class="form-errors">
      <h4>Please correct the following errors:</h4>
      <ul>
        {{ range .formErrors }}
        <li>{{.}}</li>
        {{ end }}
      </ul>
    </div>
    {{- end }}

    <form action="/companies/{{.company.ID}}/shareholders/add" method="post">
      {{- if .csrfToken }}
      <input type="hidden" name="csrf_token" value="{{.csrfToken}}">
      {{- end }}

      <fieldset>
        <legend>Shareholder Information</legend>

        <div class="grid">
          <div>
            <label for="shareholder_type">Shareholder Type</label>
            <select id="shareholder_type" name="shareholder_type">
              <option value="existing">Existing Shareholder</option>
              <option value="new">New Shareholder</option>
            </select>
          </div>
        </div>

        <div class="existing-shareholder-section">
          <label for="existing_shareholder_id">Select Existing Shareholder</label>
          <select id="existing_shareholder_id" name="existing_shareholder_id">
            <option value="">Select a shareholder</option>
            {{ range .shareholders }}
            <option value="{{.ID}}">{{.Name}} ({{.Email}})</option>
            {{ end }}
          </select>
        </div>

        <div class="new-shareholder-section" style="display: none;">
          <div class="grid">
            <div>
              <label for="name">Full Name</label>
              <input type="text" id="name" name="name" placeholder="Enter shareholder name" value="{{.form.Name}}">
            </div>
            <div>
              <label for="email">Email</label>
              <input type="email" id="email" name="email" placeholder="shareholder@example.com" value="{{.form.Email}}">
            </div>
          </div>

          <div class="grid">
            <div>
              <label for="phone">Phone</label>
              <input type="tel" id="phone" name="phone" placeholder="+1 234 567 8900" value="{{.form.Phone}}">
            </div>
            <div>
              <label for="identification">Identification Number</label>
              <input type="text" id="identification" name="identification" placeholder="ID or Passport number" value="{{.form.Identification}}">
            </div>
          </div>
        </div>
      </fieldset>

      <fieldset>
        <legend>Share Information</legend>

        <div class="grid">
          <div>
            <label for="shares">Number of Shares</label>
            <input type="number" id="shares" name="shares" min="1" placeholder="Number of shares" value="{{.form.Shares}}">
          </div>
          <div>
            <label for="share_price">Share Price</label>
            <div class="input-group">
              <span>$</span>
              <input type="number" id="share_price" name="share_price" min="0.01" step="0.01" placeholder="Price per share" value="{{.form.SharePrice}}">
            </div>
          </div>
        </div>

        <div>
          <label for="acquisition_date">Acquisition Date</label>
          <input type="date" id="acquisition_date" name="acquisition_date" value="{{.form.AcquisitionDate}}">
        </div>

        <div>
          <label for="notes">Notes</label>
          <textarea id="notes" name="notes" placeholder="Additional notes about this share acquisition" rows="3">{{.form.Notes}}</textarea>
        </div>
      </fieldset>

      <div class="form-actions">
        <button type="submit" role="button">Add Shareholder</button>
        <a href="/companies/{{.company.ID}}" role="button" class="secondary">Cancel</a>
      </div>
    </form>
  </article>
{{ end }}

{{ block "scripts" }}
  <script>
    // Toggle between existing and new shareholder forms
    document.getElementById('shareholder_type').addEventListener('change', function() {
      const existingSection = document.querySelector('.existing-shareholder-section');
      const newSection = document.querySelector('.new-shareholder-section');
      
      if (this.value === 'existing') {
        existingSection.style.display = 'block';
        newSection.style.display = 'none';
      } else {
        existingSection.style.display = 'none';
        newSection.style.display = 'block';
      }
    });
  </script>
{{ end }}