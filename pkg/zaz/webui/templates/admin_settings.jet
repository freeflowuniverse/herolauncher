{{ extends "./layout.jet" }}

{{ block content() }}
  <article>
    <header>
      <h2>System Settings</h2>
      <p>Configure the Freezone Manager system settings</p>
    </header>

    {{ if .success }}
    <div class="flash-message success">
      <div class="container">
        <p>{{ .success }}</p>
      </div>
    </div>
    {{ end }}

    {{ if .error }}
    <div class="flash-message error">
      <div class="container">
        <p>{{ .error }}</p>
      </div>
    </div>
    {{ end }}

    <form action="/admin/settings" method="post">
      {{ if .csrfToken }}
      <input type="hidden" name="csrf_token" value="{{ .csrfToken }}">
      {{ end }}

      <fieldset>
        <legend>General Settings</legend>

        <div class="grid">
          <div>
            <label for="site_name">Site Name</label>
            <input type="text" id="site_name" name="site_name" value="{{ .settings.SiteName }}">
          </div>

          <div>
            <label for="site_description">Site Description</label>
            <input type="text" id="site_description" name="site_description" value="{{ .settings.SiteDescription }}">
          </div>
        </div>

        <div class="grid">
          <div>
            <label for="company_email">Company Email</label>
            <input type="email" id="company_email" name="company_email" value="{{ .settings.CompanyEmail }}">
          </div>

          <div>
            <label for="support_email">Support Email</label>
            <input type="email" id="support_email" name="support_email" value="{{ .settings.SupportEmail }}">
          </div>
        </div>
      </fieldset>

      <fieldset>
        <legend>Security Settings</legend>

        <div class="grid">
          <div>
            <label for="session_timeout">Session Timeout (minutes)</label>
            <input type="number" id="session_timeout" name="session_timeout" min="5" value="{{ .settings.SessionTimeout }}">
          </div>

          <div>
            <label for="password_policy">Password Policy</label>
            <select id="password_policy" name="password_policy">
              {{ if eq .settings.PasswordPolicy "basic" }}
              <option value="basic" selected="selected">Basic (min 8 chars)</option>
              {{ else }}
              <option value="basic">Basic (min 8 chars)</option>
              {{ end }}

              {{ if eq .settings.PasswordPolicy "standard" }}
              <option value="standard" selected="selected">Standard (min 8 chars, mixed case, numbers)</option>
              {{ else }}
              <option value="standard">Standard (min 8 chars, mixed case, numbers)</option>
              {{ end }}

              {{ if eq .settings.PasswordPolicy "strong" }}
              <option value="strong" selected="selected">Strong (min 12 chars, mixed case, numbers, symbols)</option>
              {{ else }}
              <option value="strong">Strong (min 12 chars, mixed case, numbers, symbols)</option>
              {{ end }}
            </select>
          </div>
        </div>

        <div class="grid">
          <div>
            <label for="login_attempts">Max Login Attempts</label>
            <input type="number" id="login_attempts" name="login_attempts" min="3" value="{{ .settings.MaxLoginAttempts }}">
          </div>

          <div>
            <label for="lockout_duration">Lockout Duration (minutes)</label>
            <input type="number" id="lockout_duration" name="lockout_duration" min="5" value="{{ .settings.LockoutDuration }}">
          </div>
        </div>

        <div class="checkbox-item">
          {{ if .settings.Enable2FA }}
          <input type="checkbox" id="enable_2fa" name="enable_2fa" checked="checked">
          {{ else }}
          <input type="checkbox" id="enable_2fa" name="enable_2fa">
          {{ end }}
          <label for="enable_2fa">Enable Two-Factor Authentication</label>
        </div>
      </fieldset>

      <fieldset>
        <legend>Email Settings</legend>

        <div class="grid">
          <div>
            <label for="smtp_host">SMTP Host</label>
            <input type="text" id="smtp_host" name="smtp_host" value="{{ .settings.SMTPHost }}">
          </div>

          <div>
            <label for="smtp_port">SMTP Port</label>
            <input type="number" id="smtp_port" name="smtp_port" value="{{ .settings.SMTPPort }}">
          </div>
        </div>

        <div class="grid">
          <div>
            <label for="smtp_user">SMTP Username</label>
            <input type="text" id="smtp_user" name="smtp_user" value="{{ .settings.SMTPUser }}">
          </div>

          <div>
            <label for="smtp_password">SMTP Password</label>
            <input type="password" id="smtp_password" name="smtp_password" placeholder="Leave blank to keep current password">
          </div>
        </div>

        <div class="checkbox-item">
          {{ if .settings.SMTPSecure }}
          <input type="checkbox" id="smtp_secure" name="smtp_secure" checked="checked">
          {{ else }}
          <input type="checkbox" id="smtp_secure" name="smtp_secure">
          {{ end }}
          <label for="smtp_secure">Use Secure Connection (TLS)</label>
        </div>
      </fieldset>

      <fieldset>
        <legend>System Maintenance</legend>

        <div class="grid">
          <div>
            <label for="backup_frequency">Automatic Backup Frequency</label>
            <select id="backup_frequency" name="backup_frequency">
              {{ if eq .settings.BackupFrequency "daily" }}
              <option value="daily" selected="selected">Daily</option>
              {{ else }}
              <option value="daily">Daily</option>
              {{ end }}

              {{ if eq .settings.BackupFrequency "weekly" }}
              <option value="weekly" selected="selected">Weekly</option>
              {{ else }}
              <option value="weekly">Weekly</option>
              {{ end }}

              {{ if eq .settings.BackupFrequency "monthly" }}
              <option value="monthly" selected="selected">Monthly</option>
              {{ else }}
              <option value="monthly">Monthly</option>
              {{ end }}

              {{ if eq .settings.BackupFrequency "never" }}
              <option value="never" selected="selected">Never</option>
              {{ else }}
              <option value="never">Never</option>
              {{ end }}
            </select>
          </div>

          <div>
            <label for="backup_retention">Backup Retention (days)</label>
            <input type="number" id="backup_retention" name="backup_retention" min="1" value="{{ .settings.BackupRetention }}">
          </div>
        </div>

        <div class="grid">
          <div>
            <label for="log_level">Log Level</label>
            <select id="log_level" name="log_level">
              {{ if eq .settings.LogLevel "error" }}
              <option value="error" selected="selected">Error</option>
              {{ else }}
              <option value="error">Error</option>
              {{ end }}

              {{ if eq .settings.LogLevel "warning" }}
              <option value="warning" selected="selected">Warning</option>
              {{ else }}
              <option value="warning">Warning</option>
              {{ end }}

              {{ if eq .settings.LogLevel "info" }}
              <option value="info" selected="selected">Info</option>
              {{ else }}
              <option value="info">Info</option>
              {{ end }}

              {{ if eq .settings.LogLevel "debug" }}
              <option value="debug" selected="selected">Debug</option>
              {{ else }}
              <option value="debug">Debug</option>
              {{ end }}
            </select>
          </div>

          <div>
            <label for="log_retention">Log Retention (days)</label>
            <input type="number" id="log_retention" name="log_retention" min="1" value="{{ .settings.LogRetention }}">
          </div>
        </div>
      </fieldset>

      <div class="form-actions">
        <button type="submit" role="button">Save Settings</button>
        <button type="button" id="test-email" class="secondary">Test Email</button>
        <a href="/admin" role="button" class="outline">Cancel</a>
      </div>
    </form>
  </article>
{{ end }}

{{ block scripts() }}
  <script>
    // Test email functionality
    document.getElementById('test-email').addEventListener('click', function() {
      const emailSettings = {
        host: document.getElementById('smtp_host').value,
        port: document.getElementById('smtp_port').value,
        user: document.getElementById('smtp_user').value,
        password: document.getElementById('smtp_password').value,
        secure: document.getElementById('smtp_secure').checked,
        testEmail: document.getElementById('company_email').value
      };
      
      // Show loading state
      this.textContent = 'Sending...';
      this.disabled = true;
      
      // Send test email request
      fetch('/admin/settings/test-email', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': '{{ .csrfToken }}'
        },
        body: JSON.stringify(emailSettings)
      })
      .then(response => response.json())
      .then(data => {
        // Reset button state
        this.textContent = 'Test Email';
        this.disabled = false;
        
        // Show result
        if (data.success) {
          alert('Test email sent successfully!');
        } else {
          alert('Failed to send test email: ' + data.error);
        }
      })
      .catch(error => {
        // Reset button state
        this.textContent = 'Test Email';
        this.disabled = false;
        
        // Show error
        alert('Error: ' + error.message);
      });
    });
  </script>
{{ end }}