{{ extends "./layout" }}

{{ block documentBody() }}
<article>
  <header class="action-header">
    <hgroup>
      <h2>Board Meetings</h2>
      <p>Manage all board meetings in the Freezone</p>
    </hgroup>
    <a href="/boardmeetings/create" role="button">Schedule Meeting</a>
  </header>

  <div class="action-bar">
    <form class="search-form" role="search" action="/boardmeetings" method="get">
      <input type="search" name="search" placeholder="Search meetings..." value="{{ search }}">
      <button type="submit">Search</button>
    </form>
  </div>

  {{ if boardMeetings }}
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Company</th>
        <th>Title</th>
        <th>Date</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      {{ range boardMeetings }}
      <tr>
        <td>{{ .ID }}</td>
        <td>{{ .Company.Name }}</td>
        <td>{{ .Title }}</td>
        <td>{{ if .Date }}{{ .Date.Format("2006-01-02") }}{{ else }}N/A{{ end }}</td>
        <td>{{ .Status }}</td>
        <td class="actions">
          <a href="/boardmeetings/{{ .ID }}" title="View Details">Details</a>
          {{ if .Status == "Completed" }}
          <a href="/boardmeetings/{{ .ID }}/minutes" title="View Minutes">Minutes</a>
          {{ end }}
        </td>
      </tr>
      {{ end }}
    </tbody>
  </table>
  {{ else }}
  <div class="empty-state">
    <p>No board meetings found</p>
    {{ if search }}
    <p>No results for "{{ search }}"</p>
    <a href="/boardmeetings">Clear search</a>
    {{ else }}
    <a href="/boardmeetings/create" role="button">Schedule your first meeting</a>
    {{ end }}
  </div>
  {{ end }}
</article>
{{ end }}