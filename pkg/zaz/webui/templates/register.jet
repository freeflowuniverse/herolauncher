{{ extends "./layout" }}

{{ block documentBody() }}
<article class="register-form">
  <header>
    <h2>Register</h2>
    <p>Create a new account for the Freezone Manager</p>
  </header>

  {{ if .formErrors }}
  <div class="form-errors">
    <h4>Please correct the following errors:</h4>
    <ul>
      {{ range .formErrors }}
      <li>{{ . }}</li>
      {{ end }}
    </ul>
  </div>
  {{ end }}

  <form action="/register" method="post">
    {{ if .csrfToken }}
    <input type="hidden" name="csrf_token" value="{{ .csrfToken }}"/>
    {{ end }}
    
    <div class="grid">
      <div>
        <label for="name">Full Name</label>
        <input type="text" id="name" name="name" placeholder="John Doe" value="{{ .form.Name }}"/>
      </div>
      
      <div>
        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="your.email@example.com" value="{{ .form.Email }}"/>
      </div>
    </div>

    <div class="grid">
      <div>
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="Create a strong password"/>
      </div>
      
      <div>
        <label for="confirm_password">Confirm Password</label>
        <input type="password" id="confirm_password" name="confirm_password" placeholder="Confirm your password"/>
      </div>
    </div>

    <div class="grid">
      <div>
        <label for="company">Company (Optional)</label>
        <input type="text" id="company" name="company" placeholder="Your company name" value="{{ .form.Company }}"/>
      </div>
      
      <div>
        <label for="role">Role (Optional)</label>
        <select id="role" name="role">
          <option value="">Select your role</option>
          {{ range $role := .roles }}
          <option value="{{ $role.Value }}">{{ $role.Name }}</option>
          {{ end }}
        </select>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" role="button">Register</button>
      <a href="/login" role="button" class="secondary">Back to Login</a>
    </div>
  </form>
</article>
{{ end }}