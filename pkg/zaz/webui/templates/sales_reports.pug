extends layout

block content
  article
    header
      h2 Sales Reports
      p Analyze sales performance and generate reports
    
    .filters
      form.filter-form(action="/sales/reports" method="get")
        .grid
          div
            label(for="company_id") Company
            select(id="company_id" name="company_id")
              option(value="") All Companies
              | {{range .companies}}
              option(value="{{.ID}}" | {{ eq $.filter.CompanyID .ID}}selected{{end}}) {{.Name}}
              | {{end}}
          
          div
            label(for="period") Time Period
            select(id="period" name="period")
              option(value="this_month" | {{ eq .filter.Period "this_month"}}selected{{end}}) This Month
              option(value="last_month" | {{ eq .filter.Period "last_month"}}selected{{end}}) Last Month
              option(value="this_quarter" | {{ eq .filter.Period "this_quarter"}}selected{{end}}) This Quarter
              option(value="last_quarter" | {{ eq .filter.Period "last_quarter"}}selected{{end}}) Last Quarter
              option(value="this_year" | {{ eq .filter.Period "this_year"}}selected{{end}}) This Year
              option(value="last_year" | {{ eq .filter.Period "last_year"}}selected{{end}}) Last Year
              option(value="custom" | {{ eq .filter.Period "custom"}}selected{{end}}) Custom Range
        
        .custom-date-range(style="| {{ ne .filter.Period 'custom'}}display: none;{{end}}")
          .grid
            div
              label(for="start_date") Start Date
              input(type="date" id="start_date" name="start_date" value="{{.filter.StartDate}}")
            
            div
              label(for="end_date") End Date
              input(type="date" id="end_date" name="end_date" value="{{.filter.EndDate}}")
        
        .grid
          div
            label(for="type") Sale Type
            select(id="type" name="type")
              option(value="") All Types
              option(value="product" | {{ eq .filter.Type "product"}}selected{{end}}) Products
              option(value="service" | {{ eq .filter.Type "service"}}selected{{end}}) Services
              option(value="subscription" | {{ eq .filter.Type "subscription"}}selected{{end}}) Subscriptions
              option(value="other" | {{ eq .filter.Type "other"}}selected{{end}}) Other
          
          div
            label(for="status") Status
            select(id="status" name="status")
              option(value="") All Statuses
              option(value="pending" | {{ eq .filter.Status "pending"}}selected{{end}}) Pending
              option(value="paid" | {{ eq .filter.Status "paid"}}selected{{end}}) Paid
              option(value="shipped" | {{ eq .filter.Status "shipped"}}selected{{end}}) Shipped
              option(value="completed" | {{ eq .filter.Status "completed"}}selected{{end}}) Completed
              option(value="cancelled" | {{ eq .filter.Status "cancelled"}}selected{{end}}) Cancelled
        
        .filter-actions
          button(type="submit" role="button") Generate Report
          button(type="button" class="secondary" id="export-report") Export CSV
    
    .report-summary
      h3 Summary: {{.report.Title}}
      
      .grid
        div
          article
            header
              h4 Total Sales
            p.big-number ${{.report.TotalAmount}}
            p.comparison
              | | {{ gt .report.PercentChange 0}}
              span.positive +{{.report.PercentChange}}% vs previous period
              | {{else}}
              span.negative {{.report.PercentChange}}% vs previous period
              | {{end}}
        
        div
          article
            header
              h4 Number of Transactions
            p.big-number {{.report.TransactionCount}}
            p.small-text Average: ${{.report.AverageTransactionValue}} per sale
        
        div
          article
            header
              h4 Top Performing
            | | {{ .report.TopPerformer}}
            p.medium-text {{.report.TopPerformer.Name}}
            p.small-text ${{.report.TopPerformer.Amount}} ({{.report.TopPerformer.Percentage}}% of total)
            | {{else}}
            p.small-text No data available
            | {{end}}
    
    .report-charts
      .grid
        div
          h3 Sales by Type
          .chart-container
            #sales-by-type-chart(style="width: 100%; height: 300px;")
        
        div
          h3 Sales Trend
          .chart-container
            #sales-trend-chart(style="width: 100%; height: 300px;")
    
    .report-data
      h3 Detailed Sales Data
      
      | {{if .report.Sales}}
      table
        thead
          tr
            th Date
            th Company
            th Type
            th Customer
            th Amount
            th Status
        tbody
          | {{range .report.Sales}}
          tr
            td {{.Date}}
            td {{.CompanyName}}
            td {{.Type}}
            td {{.CustomerName}}
            td ${{.Amount}}
            td {{.Status}}
          | {{end}}
      | {{else}}
      p.no-data No sales data available for the selected filters.
      | {{end}}

block scripts
  script.
    // Toggle custom date range based on period selection
    document.getElementById('period').addEventListener('change', function() {
      const customDateRange = document.querySelector('.custom-date-range');
      
      if (this.value === 'custom') {
        customDateRange.style.display = 'block';
      } else {
        customDateRange.style.display = 'none';
      }
    });
    
    // Initialize charts
    document.addEventListener('DOMContentLoaded', function() {
      // Sales by Type chart
      const typeChart = echarts.init(document.getElementById('sales-by-type-chart'));
      
      const typeChartOption = {
        tooltip: {
          trigger: 'item',
          formatter: '{a} <br/>{b}: ${c} ({d}%)'
        },
        legend: {
          orient: 'vertical',
          right: 10,
          top: 'center',
          data: [| {{range .report.SalesByType}}'{{.Type}}',{{end}}]
        },
        series: [
          {
            name: 'Sales Amount',
            type: 'pie',
            radius: ['50%', '70%'],
            avoidLabelOverlap: false,
            label: {
              show: false,
              position: 'center'
            },
            emphasis: {
              label: {
                show: true,
                fontSize: '18',
                fontWeight: 'bold'
              }
            },
            labelLine: {
              show: false
            },
            data: [
              | {{range .report.SalesByType}}
              {
                value: | {{.Amount}},
                name: '| {{.Type}}'
              },
              | {{end}}
            ]
          }
        ]
      };
      
      typeChart.setOption(typeChartOption);
      
      // Sales Trend chart
      const trendChart = echarts.init(document.getElementById('sales-trend-chart'));
      
      const trendChartOption = {
        tooltip: {
          trigger: 'axis',
          formatter: function(params) {
            const param = params[0];
            return param.name + '<br/>' + param.seriesName + ': $' + param.value;
          }
        },
        xAxis: {
          type: 'category',
          data: [| {{range .report.SalesTrend}}'{{.Period}}',{{end}}]
        },
        yAxis: {
          type: 'value',
          axisLabel: {
            formatter: '${value}'
          }
        },
        series: [
          {
            name: 'Sales Amount',
            type: 'line',
            data: [| {{range .report.SalesTrend}}{{.Amount}},{{end}}],
            markPoint: {
              data: [
                { type: 'max', name: 'Max' },
                { type: 'min', name: 'Min' }
              ]
            }
          }
        ]
      };
      
      trendChart.setOption(trendChartOption);
      
      // Resize charts when window size changes
      window.addEventListener('resize', function() {
        typeChart.resize();
        trendChart.resize();
      });
      
      // Export to CSV functionality
      document.getElementById('export-report').addEventListener('click', function() {
        // Create CSV content
        let csvContent = 'Date,Company,Type,Customer,Amount,Status\n';
        
        | {{range .report.Sales}}
        csvContent += '| {{.Date}},{{.CompanyName}},{{.Type}},{{.CustomerName}},${{.Amount}},{{.Status}}\n';
        | {{end}}
        
        // Create download link
        const encodedUri = encodeURI('data:text/csv;charset=utf-8,' + csvContent);
        const link = document.createElement('a');
        link.setAttribute('href', encodedUri);
        link.setAttribute('download', 'sales_report_| {{.report.ExportFileName}}.csv');
        document.body.appendChild(link);
        
        // Trigger download
        link.click();
        
        // Clean up
        document.body.removeChild(link);
      });
    });
