extends layout

block content
  article
    header
      h2 Sales Reports
      p Analyze sales performance and generate reports
    
    .filters
      form.filter-form(action="/sales/reports" method="get")
        .grid
          div
            label(for="company_id") Company
            select(id="company_id" name="company_id")
              option(value="") All Companies
              option(value="1") Example Company
              option(value="2") Another Company
          
          div
            label(for="period") Time Period
            select(id="period" name="period")
              option(value="this_month") This Month
              option(value="last_month") Last Month
              option(value="this_quarter") This Quarter
              option(value="last_quarter") Last Quarter
              option(value="this_year") This Year
              option(value="custom") Custom Range
        
        .custom-date-range(style="display: none;")
          .grid
            div
              label(for="start_date") Start Date
              input(type="date" id="start_date" name="start_date" value="2025-03-01")
            
            div
              label(for="end_date") End Date
              input(type="date" id="end_date" name="end_date" value="2025-03-28")
        
        .grid
          div
            label(for="type") Sale Type
            select(id="type" name="type")
              option(value="") All Types
              option(value="product") Products
              option(value="service") Services
              option(value="subscription") Subscriptions
          
          div
            label(for="status") Status
            select(id="status" name="status")
              option(value="") All Statuses
              option(value="pending") Pending
              option(value="paid") Paid
              option(value="completed") Completed
              option(value="cancelled") Cancelled
        
        .filter-actions
          button(type="submit" role="button") Generate Report
          button(type="button" class="secondary" id="export-report") Export CSV
    
    .report-summary
      h3 Summary: Monthly Sales Report (March 2025)
      
      .grid
        div
          article
            header
              h4 Total Sales
            p.big-number $45,250
            p.comparison
              span.positive +12.5% vs previous period
        
        div
          article
            header
              h4 Number of Transactions
            p.big-number 24
            p.small-text Average: $1,885 per sale
        
        div
          article
            header
              h4 Top Performing
            p.medium-text Example Company
            p.small-text $28,500 (63% of total)
    
    .report-charts
      .grid
        div
          h3 Sales by Type
          .chart-container
            #sales-by-type-chart(style="width: 100%; height: 300px;")
            p.chart-placeholder Sales by Type chart will appear here
        
        div
          h3 Sales Trend
          .chart-container
            #sales-trend-chart(style="width: 100%; height: 300px;")
            p.chart-placeholder Sales Trend chart will appear here
    
    .report-data
      h3 Detailed Sales Data
      
      table
        thead
          tr
            th Date
            th Company
            th Type
            th Customer
            th Amount
            th Status
        tbody
          tr
            td 2025-03-05
            td Example Company
            td Product
            td John Smith
            td $2,500
            td Completed
          tr
            td 2025-03-12
            td Another Company
            td Service
            td Jane Doe
            td $1,750
            td Paid
          tr
            td 2025-03-18
            td Example Company
            td Subscription
            td Acme Corp
            td $5,000
            td Completed
          tr
            td 2025-03-25
            td Another Company
            td Product
            td Global Industries
            td $3,200
            td Pending

block scripts
  script.
    // Toggle custom date range based on period selection
    document.getElementById('period').addEventListener('change', function() {
      const customDateRange = document.querySelector('.custom-date-range');
      
      if (this.value === 'custom') {
        customDateRange.style.display = 'block';
      } else {
        customDateRange.style.display = 'none';
      }
    });
    
    // Placeholder for chart initialization
    document.addEventListener('DOMContentLoaded', function() {
      console.log('Charts would be initialized here');
      
      // Export to CSV functionality
      document.getElementById('export-report').addEventListener('click', function() {
        alert('CSV export functionality would be triggered here');
      });
    });
