extends layout

block content
  article.compact
    header.slim-header
      h2 Product Details
      .header-actions.button-group
        a(href="/products/{{.product.ID}}/edit" role="button" class="secondary small") Edit Product
        a(href="/products" role="button" class="outline small") Back to List
        
    .product-info.grid
      .product-profile
        h3 {{.product.Name}}
        
        p.identification
          strong ID: 
          span {{.product.ID}}
        p.category
          strong Category: 
          span {{.product.Category}}
        p.type
          strong Type: 
          span {{.product.Type}}
        p.status
          strong Status: 
          span {{.product.Status}}
        
      .product-pricing
        h3 Pricing Information
        p.price
          strong Price: 
          span {{printf "%.2f" .product.Price}} {{.product.Currency}}
        p.created
          strong Created At: 
          span {{.product.CreatedAt.Format "2006-01-02"}}
        p.updated
          strong Updated At: 
          span {{.product.UpdatedAt.Format "2006-01-02"}}
        
      .product-description
        h3 Description
        p {{.product.Description}}
      
    section.additional-info
      h3 Additional Information
      
      p This product is currently {{.product.Status}}.
      p Category: {{.product.Category}}
      p Type: {{.product.Type}}
