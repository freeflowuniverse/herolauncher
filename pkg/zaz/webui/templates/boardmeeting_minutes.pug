extends layout

block content
  article.compact
    header.slim-header
      h2 Meeting Minutes
      .header-actions.button-group
        a(href="#" role="button" class="outline small") Back to Meeting
        
    .meeting-header
      h3 Board Meeting Minutes
      
      .meeting-meta
        p
          strong Company: 
          a(href="#") Company Name
        p
          strong Date: 
          span Meeting Date
        p
          strong Location: 
          span Meeting Location
        p
          strong Status: 
          span(class="status") Status
    
    // Simplified content for meeting minutes
    section.minutes-content
      fieldset
        legend Meeting Information
        
        .grid
          div
            label(for="start_time") Start Time
            input(type="time" id="start_time" name="start_time")
          
          div
            label(for="end_time") End Time
            input(type="time" id="end_time" name="end_time")
      
      fieldset
        legend Attendees
        
        .attendees-section
          .checkbox-item
            input(type="checkbox" id="attendee_1" name="attendees[]" value="1")
            label(for="attendee_1") John Doe (Chairman)
          
          .checkbox-item
            input(type="checkbox" id="attendee_2" name="attendees[]" value="2")
            label(for="attendee_2") Jane Smith (Secretary)
          
          div
            label(for="additional_attendees") Additional Attendees
            input(type="text" id="additional_attendees" name="additional_attendees" placeholder="Other attendees not listed above")
      
      fieldset
        legend Agenda and Discussion
        
        .agenda-item
          h4 1. Financial Report
          
          div
            label(for="discussion_0") Discussion
            textarea(id="discussion_0" name="discussions[]" rows="4" placeholder="Record discussion for this agenda item")
          
          div
            label(for="decision_0") Decision/Action Item
            textarea(id="decision_0" name="decisions[]" rows="2" placeholder="Record any decisions or action items")
        
        .agenda-item
          h4 2. Strategic Planning
          
          div
            label(for="discussion_1") Discussion
            textarea(id="discussion_1" name="discussions[]" rows="4" placeholder="Record discussion for this agenda item")
          
          div
            label(for="decision_1") Decision/Action Item
            textarea(id="decision_1" name="decisions[]" rows="2" placeholder="Record any decisions or action items")
      
      fieldset
        legend Resolutions
        
        .resolutions-section
          .resolution-items
            .resolution-item
              div
                label(for="resolution_title_0") Resolution Title
                input(type="text" id="resolution_title_0" name="resolution_titles[]" placeholder="Resolution title")
              
              div
                label(for="resolution_text_0") Resolution Text
                textarea(id="resolution_text_0" name="resolution_texts[]" rows="3" placeholder="Full text of the resolution")
              
              .grid
                div
                  label(for="resolution_votes_for_0") Votes For
                  input(type="number" id="resolution_votes_for_0" name="resolution_votes_for[]" min="0" value="0")
                
                div
                  label(for="resolution_votes_against_0") Votes Against
                  input(type="number" id="resolution_votes_against_0" name="resolution_votes_against[]" min="0" value="0")
                
                div
                  label(for="resolution_votes_abstained_0") Abstained
                  input(type="number" id="resolution_votes_abstained_0" name="resolution_votes_abstained[]" min="0" value="0")
              
              div
                label(for="resolution_result_0") Result
                select(id="resolution_result_0" name="resolution_results[]")
                  option(value="") Select result
                  option(value="Approved") Approved
                  option(value="Rejected") Rejected
                  option(value="Deferred") Deferred
                  option(value="Withdrawn") Withdrawn
              
              button.remove-resolution(type="button") Remove
          
          button.add-resolution(type="button") + Add Resolution
      
      fieldset
        legend Additional Notes
        
        div
          label(for="additional_notes") Additional Notes
          textarea(id="additional_notes" name="additional_notes" rows="5" placeholder="Any additional notes or comments about the meeting")
      
      .form-actions
        button(type="submit" name="action" value="save" role="button") Save Minutes
        button(type="submit" name="action" value="finalize" role="button" class="secondary") Finalize Minutes

    section.minutes-content.hidden
      h3 Meeting Minutes
      
      .minutes-meta
        p
          strong Start Time: 
          span 10:00 AM
        p
          strong End Time: 
          span 11:30 AM
        p
          strong Recorded By: 
          span Jane Smith
      
      section.attendees-list
        h4 Attendees
        
        ul
          li John Doe (Chairman)
          li Jane Smith (Secretary)
          li Additional attendees
      
      section.agenda-discussions
        h4 Agenda and Discussions
        
        .agenda-discussion
          h5 1. Financial Report
          
          div.discussion
            h6 Discussion:
            p The financial report for Q1 was presented and discussed.
          
          div.decision
            h6 Decision/Action Item:
            p The board approved the financial report unanimously.
        
        .agenda-discussion
          h5 2. Strategic Planning
          
          div.discussion
            h6 Discussion:
            p The strategic plan for the next fiscal year was presented.
          
          div.decision
            h6 Decision/Action Item:
            p The board requested additional information before making a decision.
      
      section.resolutions
        h4 Resolutions
        
        .resolution
          h5 Approval of Financial Report
          
          .resolution-text
            p The board approves the Q1 financial report as presented.
          
          .resolution-result
            p
              strong Result: 
              span Approved (For: 5, Against: 0, Abstained: 0)
      
      section.additional-notes
        h4 Additional Notes
        
        p The meeting was adjourned at 11:30 AM.

block scripts
  script(src="/static/js/boardmeeting-minutes.js")
