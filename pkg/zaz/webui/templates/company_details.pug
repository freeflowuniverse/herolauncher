extends layout

block content
  article.compact
    header.slim-header
      h2 Company Details
      .header-actions.button-group
        a(href="/companies/{{.company.ID}}/edit" role="button" class="secondary small") Edit Company
        a(href="/companies" role="button" class="outline small") Back to List
        
    .company-info.grid
      .company-profile
        h3 {{.company.Name}}
        
        p.registration
          strong Registration #: 
          span {{.company.RegistrationNumber}}
        p.incorporation
          strong Incorporated: 
          span {{.company.IncorporationDate}}
        p.status
          strong Status: 
          span(class="status") {{.company.Status}}
        p.business-type
          strong Business Type: 
          span {{.company.BusinessType}}
        p.industry
          strong Industry: 
          span {{.company.Industry}}
        
      .company-contact
        h3 Contact Information
        p
          strong Email: 
          a(href="mailto:{{.company.Email}}") {{.company.Email}}
        p
          strong Phone: 
          span {{.company.Phone}}
        p
          strong Website: 
          | {{if .company.Website}}
          a(href="{{.company.Website}}" target="_blank") {{.company.Website}}
          | {{else}}
          span Not provided
          | {{end}}
        
      .company-description
        h3 Description
        | {{if .company.Description}}
        p {{.company.Description}}
        | {{else}}
        p No description provided.
        | {{end}}
      
    section.shareholders
      h3 Shareholders
      | {{if .company.Shareholders}}
      table
        thead
          tr
            th Name
            th Shares
            th Percentage
            th Since
            th Actions
        tbody
          | {{range .company.Shareholders}}
          tr
            td {{.Name}}
            td {{.Shares}}
            td {{.Percentage}}%
            td {{.Since}}
            td.actions
              a.action-button(href="/shareholders/{{.ID}}" title="View Details") Details
          | {{end}}
      | {{else}}
      p.no-data No shareholders registered for this company.
      | {{end}}
      
    section.board-meetings
      h3 Board Meetings
      a(href="/companies/{{.company.ID}}/boardmeetings/schedule" role="button" class="outline") Schedule Meeting
      
      | {{if .boardMeetings}}
      table
        thead
          tr
            th Date
            th Title
            th Attendees
            th Status
            th Actions
        tbody
          | {{range .boardMeetings}}
          tr
            td {{.Date}}
            td {{.Title}}
            td {{len .Attendees}}
            td {{.Status}}
            td.actions
              a.action-button(href="/boardmeetings/{{.ID}}" title="View Details") Details
              | {{if eq .Status "Completed"}}
              a.action-button(href="/boardmeetings/{{.ID}}/minutes" title="Meeting Minutes") Minutes
              | {{end}}
          | {{end}}
      | {{else}}
      p.no-data No board meetings scheduled for this company.
      | {{end}}
