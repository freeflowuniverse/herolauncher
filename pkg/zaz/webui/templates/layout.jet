<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
      Zanzibar Autonomous Zone Admin
    </title>
    <link rel="icon" href="/img/freezone-icon.svg" type="image/svg+xml">
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/pico.min.css">
    <link rel="stylesheet" href="/css/freezone.css">
    <link rel="stylesheet" href="/css/right-sidebar.css">
    <link rel="stylesheet" href="/css/unpoly.min.css">
    {{ if .customCSS }}
    <style>
      {{.customCSS}}
    </style>
    {{ end }}
</head>
<body class=".bodyClass">
    {{ if .flashMessage }}
    <div class="flash-message {{.flashMessage.Type}}">
        <div class="container">
            <p>{{.flashMessage.Text}}</p>
            <button class="close-flash">&times;</button>
        </div>
    </div>
    {{ end }}
    
    {{ include "partials/header" }}
    
    <div class="container">
      <div class="grid grid-sidebar">
        <!-- Left sidebar -->
        {{ include "partials/sidebar" }}
        
        <!-- Main content area -->
        <main class="content-area">
          {{block documentBody()}}{{end}}
        </main>
        
        <!-- Right sidebar -->
        {{ include "partials/right-sidebar" }}
      </div>
    </div>
    
    <footer>
        <div class="container">
            <p>&copy; {{.currentYear}} Freezone Manager - A FreeFlow Universe Project</p>
        </div>
    </footer>
    
    <script src="/js/unpoly.min.js"></script>
    <script src="/js/echarts/echarts.min.js"></script>
    <script src="/js/freezone.js"></script>
    <script src="/js/sidebar.js"></script>
    {{ if .customJS }}
    <script>
      {{.customJS}}
    </script>
    {{ end }}
</body>
</html>
