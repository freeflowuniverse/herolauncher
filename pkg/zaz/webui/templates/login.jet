{{ extends "./layout" }}

{{ block content() }}
<article class="login-form">
  <header>
    <h2>Login</h2>
    <p>Please enter your credentials to access the Freezone Manager</p>
  </header>

  {{ if .error }}
  <div class="error-message">
    <p>{{ .error }}</p>
  </div>
  {{ end }}

  <form action="/login" method="post">
    {{ if .csrfToken }}
    <input type="hidden" name="csrf_token" value="{{ .csrfToken }}">
    {{ end }}
    
    <div class="grid">
      <div>
        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="your.email@example.com" value="{{ .form.Email }}">
      </div>
      
      <div>
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="Enter your password">
      </div>
    </div>
    
    <div class="form-actions">
      <button type="submit" role="button">Login</button>
      <a href="/register" role="button" class="secondary">Register</a>
      <a href="/forgot-password">Forgot Password?</a>
    </div>
  </form>
</article>
{{ end }}