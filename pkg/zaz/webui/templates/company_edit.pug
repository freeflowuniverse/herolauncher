extends layout

block content
  article.compact
    header.slim-header
      h2 Edit Company
      .header-actions.button-group
        a(href="/companies/{{.company.ID}}" role="button" class="outline small") Cancel
        a(href="/companies" role="button" class="outline small") Back to List
        
    form(action="/companies/{{.company.ID}}/edit" method="POST")
      .grid
        .form-group
          label(for="name") Company Name
          input(type="text" id="name" name="name" value="{{.company.Name}}")
          
        .form-group
          label(for="registration_number") Registration Number
          input(type="text" id="registration_number" name="registration_number" value="{{.company.RegistrationNumber}}")
          
        .form-group
          label(for="business_type") Business Type
          select(id="business_type" name="business_type")
            option(value="Corporation") Corporation
            option(value="LLC") LLC
            option(value="Partnership") Partnership
            option(value="Sole Proprietorship") Sole Proprietorship
            option(value="Non-Profit") Non-Profit
            
        .form-group
          label(for="industry") Industry
          input(type="text" id="industry" name="industry" value="{{.company.Industry}}")
          
        .form-group
          label(for="status") Status
          select(id="status" name="status")
            option(value="Active") Active
            option(value="Inactive") Inactive
            option(value="Pending") Pending
            option(value="Dissolved") Dissolved
            
        .form-group
          label(for="email") Email
          input(type="email" id="email" name="email" value="{{.company.Email}}")
          
        .form-group
          label(for="phone") Phone
          input(type="tel" id="phone" name="phone" value="{{.company.Phone}}")
          
        .form-group
          label(for="website") Website
          input(type="url" id="website" name="website" value="{{.company.Website}}")
          
        .form-group.full-width
          label(for="address") Address
          textarea(id="address" name="address" rows="2") {{.company.Address}}
          
        .form-group.full-width
          label(for="description") Description
          textarea(id="description" name="description" rows="4") {{.company.Description}}
          
      .form-actions
        button(type="submit" class="primary") Save Changes
        a(href="/companies/{{.company.ID}}" role="button" class="secondary") Cancel
        
      | {{if .error}}
      .error-message
        p {{.error}}
      | {{end}}
